macro cint_physics
*
*    To generate the dictionary for the PHYSICS classes
*    ==================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h


headers=TLorentzVector.h TVector2.h TVector3.h

name=PHYSICS
patch=PHYSICS

set G__LinkDef.h -F TEXT
ctot /$kumacs/PHYSICS_LinkDef

exec makecint [name] [patch] [headers]

return
