macro cint_win32
*
*    To generate the dictionary for the Window32 classes
*    ===================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=G__TypeInfo.h TWin32GuiFactory.h TGWin32.h

name=Win32
patch=WIN32

set G__LinkDef.h -F TEXT
ctot /$kumacs/WIN32_LinkDef

exec makecint [name] [patch] [headers]

return
