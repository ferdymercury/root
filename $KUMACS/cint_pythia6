macro cint_pythia6
*
*    To generate the TPythia6 dictionary
*    ===================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

sel pythia6
seq pythia6
seq -i src/*.h

headers=TPythia6.h TMCParticle.h

name=Pythia6
patch=PYTHIA6

set G__LinkDef.h -F TEXT
ctot /$kumacs/PYTHIA6_LinkDef

exec makecint [name] [patch] [headers]

return
