macro cint_cont
*
*    To generate the dictionary for all container classes
*    ====================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TArrayC.h TArrayD.h TArrayF.h TArrayI.h TArrayL.h TArrayS.h _
        TCollection.h TSeqCollection.h TIterator.h TList.h TSortedList.h _
        THashList.h TObjArray.h TClonesArray.h TOrdCollection.h TBtree.h _
        THashTable.h TMap.h TClassTable.h TObjectTable.h

name=Cont
patch=CONT

set G__LinkDef.h -F TEXT
ctot /$kumacs/CONT_LinkDef

exec makecint [name] [patch] [headers]

return
