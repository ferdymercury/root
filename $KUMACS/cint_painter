macro cint_painter
*
*    To generate the dictionary for the histogram painter
*    ====================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers= THistPainter.h TLego.h

name=HistPainter
patch=HISTPAINTER

set G__LinkDef.h -F TEXT
ctot /$kumacs/HISTPAINTER_LinkDef

exec makecint [name] [patch] [headers]

return
