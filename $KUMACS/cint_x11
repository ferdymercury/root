macro cint_x11
*
*    To generate the dictionary for the X11 classes
*    ==============================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TGX11.h

name=X11
patch=X11

set G__LinkDef.h -F TEXT
ctot /$kumacs/X11_LinkDef

exec makecint [name] [patch] [headers]

return
