macro bind_lib 1='root'   2='*.o' 3='' 4='' 5='' 6='' 7='' 8=''
* macro to generate a shared library from the sources specified in par 2.

message Generating library: $ROOTSYS/lib/lib[1].a

import *

shell /bin/rm -f $ROOTSYS/lib/lib[1].a

+IF,GCC.
if [1] = 'Cint' then
   shell /usr/ccs/bin/nm -g -C $ROOTSYS/src/[2] | egrep " D "\|" B " | awk '{print $1}' > tmp.exp
   shell gcc -o $ROOTSYS/lib/lib[1].a -shared -Wl,-bbigtoc -Wl,-bE:tmp.exp $ROOTSYS/src/[2] _
    -L$ROOTSYS/lib [3] [4] [5] [6] [7] [8]
elseif [1] = 'Core' then
   shell /usr/ccs/bin/nm -g -C [COREOBJS] | egrep " D "\|" B " | awk '{print $1}' > tmp.exp
   shell gcc -o $ROOTSYS/lib/lib[1].a -shared -Wl,-bbigtoc -Wl,-bE:tmp.exp [COREOBJS] _
    -L$ROOTSYS/lib -lCint [3] [4] [5] [6] [7] [8]
else
   shell /usr/ccs/bin/nm -g -C $ROOTSYS/src/[2] | egrep " D "\|" B " | awk '{print $1}' > tmp.exp
   shell gcc -o $ROOTSYS/lib/lib[1].a -shared -Wl,-bbigtoc -Wl,-bE:tmp.exp $ROOTSYS/src/[2] _
    -L$ROOTSYS/lib -lCint -lCore [3] [4] [5] [6] [7] [8]
endif
shell /bin/rm -f tmp.exp
+ELSE.
if [1] = 'Cint' then
   shell /usr/ibmcxx/bin/makeC++SharedLib -o $ROOTSYS/lib/lib[1].a _
    -L$ROOTSYS/lib [3] [4] [5] [6] [7] [8] -p 0 $ROOTSYS/src/[2]
elseif [1] = 'Core' then
   shell /usr/ibmcxx/bin/makeC++SharedLib -o $ROOTSYS/lib/lib[1].a _
    -L$ROOTSYS/lib [3] [4] [5] [6] [7] [8] -lCint -p 0 [COREOBJS]
else
   shell /usr/ibmcxx/bin/makeC++SharedLib -o $ROOTSYS/lib/lib[1].a _
    -L$ROOTSYS/lib [3] [4] [5] [6] [7] [8] -lCore -lCint -p 0 $ROOTSYS/src/[2]
endif
+ENDIF.

return
