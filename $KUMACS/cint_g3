macro cint_g3
*
*    To generate the dictionary (part 3) for some graphics classes
*    ===================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TStyle.h TView.h TLatex.h TStyle.h TF1.h TF2.h TF3.h

name=Graf3
patch=G

set G__LinkDef.h -F TEXT
ctot /$kumacs/G3_LinkDef

exec makecint [name] [patch] [headers]

return
