macro loadincludes 1=-

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif

if [machine] = 'IBMPC' then
   machine = 'WinNT'
endif

$OS = OS
if [OS] = 'VMS' then
   machine = 'VMS'
endif

seq . include c zip incint eg gui

if [machine] = 'HPUX' .OR. [machine] = 'IBMRT' .OR. [machine] = 'SOLARIS' .OR. _
   [machine] = 'SOLARISPC' .OR. [machine] = 'ALPHA' .OR. [machine] = 'SGI' _
  .OR. [machine] = 'LINUX' .OR.[machine] = 'HIUX' then
*** nothing for time being
elseif [machine] = 'WinNT' then
   seq Win32 IncWin32
elseif [machine] = 'Win95' then
   seq Win95 Win32 IncWin32
elseif [machine] = 'MAC' then
   seq MAC
elseif [machine] = 'VMS' then
   seq vms
else
   mess 'loadincludes: *** Unknown machine type ***'
endif

return
