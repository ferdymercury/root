MACRO install_makeexdll 1=- 2=opt

import *

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif

if [machine] = 'IBMPC' then
   machine = 'WinNT'
if [LOGFILE] = 'log' then
   set install_makeexdll.bat -xarcl
endif
endif

EXEC setup [1] [2] [LOGFILE]

SEL UTILS
cd ..

main=$ROOTSYS\src\UTILS_BINDEXPLIB.[OBJSUF]

remove [main]

CC utils/BINDEXPLIB

if [machine] = 'WinNT' then
   remove $ROOTSYS\bin\BINDEXPLIB[EXESUF]
   sh cl [main] -Fe$ROOTSYS\bin\BINDEXPLIB
else
   mess 'No link sequence specified yet in install_rootcint'
endif

sel -utils

RETURN

