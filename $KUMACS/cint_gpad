macro cint_gpad
*
*    To generate the dictionary for graphics classes based on TPad and TEditor
*    =========================================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TPad.h TCanvas.h TControlBar.h TSliderBox.h TClassTree.h _
        TFitPanel.h TFitPanelGraph.h TDrawPanelHist.h TButton.h _
        TControlBarButton.h TGroupButton.h TDialogCanvas.h TAttLineCanvas.h _
        TAttFillCanvas.h TAttTextCanvas.h TAttMarkerCanvas.h TSlider.h _
        TTreeViewer.h TPaveVar.h

name=GPad
patch=GPAD

set G__LinkDef.h -F TEXT
ctot /$kumacs/GPAD_LinkDef

exec makecint [name] [patch] [headers]

return
