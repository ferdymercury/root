macro cint_g3d
*
*    To generate the dictionary for all 3D graphics classes
*    ======================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TPolyLine3D.h TPolyMarker3D.h TGeometry.h TMaterial.h TMixture.h TNode.h _
        TNodeDiv.h TRotMatrix.h TShape.h TBRIK.h TTRD1.h TTRD2.h TTUBE.h TCONE.h TCTUB.h TELTU.h _
        TTUBS.h TCONS.h TTRAP.h TPARA.h TGTRA.h TPCON.h TPGON.h TSPHE.h TGLKernelABC.h _
        TPadOpenGLView.h TPadView3D.h TMarker3DBox.h THelix.h THYPE.h

name=G3D
patch=G3D

set G__LinkDef.h -F TEXT
ctot /$kumacs/G3D_LinkDef

exec makecint [name] [patch] [headers]

return
