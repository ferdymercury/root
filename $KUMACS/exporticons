macro exporticons
filecase keep
curdir = $CWD()
*
*  Create subdirectory tutorials if it does not exist
OS = $OS
if [OS] = 'VMS' then
  exe mkdir [.icons]
  set [.icons]*.xpm -f C++
else
  exe mkdir icons
  set icons/*.xpm -f C++
endif
*
set C++ -lan
sel icons
cd icons
cx -h  *
OS = $OS
if [OS] = 'WINNT' then
  lcd icons
  shell if exist root.mimes del root.mimes
  shell copy root.xpm root.mimes
  shell del root.xpm
  lcd ..
elseif [OS] = 'VMS' then
  shell purge/log [.icons]root.mimes
  shell rename [.icons]root.xpm [.icons]root.mimes
else
  shell /bin/rm -f icons/root.mimes
  shell /bin/mv icons/root.xpm icons/root.mimes
endif

sel -icons
*
exec sourcedir
*
cd [curdir]
return
