macro cint_x3d
*
*    To generate the dictionary for the X3D viewer
*    =============================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers= TViewerX3D.h

name=X3D
patch=X3D

set G__LinkDef.h -F TEXT
ctot /$kumacs/X3D_LinkDef

exec makecint [name] [patch] [headers]

return
