macro makeversion

*
* Run CINT macro to create include $RVersion.
*

application data G__version.cxx
int main(int argc, char *argv[])
{
   if (argc < 2) {
      printf("Usage: %s <version number in format xx.yy/zz>\n", argv[0]);
      exit(1);
   }

   const char *out = "G__version.car";
   FILE *fp = fopen(out, "w");
   if (!fp) {
      printf("%s: can not open output file %s\n", argv[0], out);
      exit(1);
   }

   fprintf(fp, "+PATCH,//ROOT/INCLUDE.\n");
   fprintf(fp, "+KEEP,RVersion,T=C.\n\n");
   fprintf(fp, "#ifndef ROOT_RVersion\n");
   fprintf(fp, "#define ROOT_RVersion\n\n");
   fprintf(fp, "/* Version information automatically generated by installer. */\n\n");
   fprintf(fp, "/*\n");
   fprintf(fp, " * These macros can be used in the following way:\n");
   fprintf(fp, " *\n");
   fprintf(fp, " *    #if ROOT_VERSION_CODE >= ROOT_VERSION(2,23,4)\n");
   fprintf(fp, " *       #include <newheader.h>\n");
   fprintf(fp, " *    #else\n");
   fprintf(fp, " *       #include <oldheader.h>\n");
   fprintf(fp, " *    #endif\n");
   fprintf(fp, " *\n");
   fprintf(fp, "*/\n\n");

   int xx, yy, zz;
   sscanf(argv[1], "%d.%d/%d", &xx, &yy, &zz);
   int vers_code = (xx << 16) + (yy << 8) + zz;

   fprintf(fp, "#define ROOT_RELEASE \"%s\"\n", argv[1]);
   fprintf(fp, "#define ROOT_VERSION_CODE %d\n", vers_code);
   fprintf(fp, "#define ROOT_VERSION(a,b,c) (((a) << 16) + ((b) << 8) + (c))\n");
   fprintf(fp, "\n#endif\n");

   fclose(fp);

   exit(0);
}
G__version.cxx


+IF,-WIN32.

shell $ROOTSYS/bin/cint G__version.cxx $version('root')

+ELSE.

shell $ROOTSYS\bin\cint G__version.cxx $version('root')

+ENDIF.

arc G__version.car -a
touch -T 11/10/99.12.00 /INCLUDE/$RVersion
remove G__*

mess DECK //ROOT/INCLUDE/$RVersion... created

return
