macro STARTests
filecase keep
curdir = $CWD()
*
*  Create subdirectory tutorials if it does not exist
if $FEXIST(STARTests) = 0 then
   message Creating directory STARTest
   if [OS] = 'VMS' then
     shell create/dir [.STARTest]
   else
     shell mkdir STARTest
   endif
endif
*
* Extract macros from cmz directory STARTests
*
if [OS]='VMS' then
   set [.STARTest]*.C -f C++
else
   set STARTest/*.C -f C++
endif

set C++ -lan
sel STARTest
cd STARTest
cx -h  *

sel -STARTest
*
exec sourcedir
*
cd [curdir]
