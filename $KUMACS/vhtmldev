macro vhtmldev 1=-
*
*   To generate the HTML version of CMZ release notes
*
curdir = $CWD()
cd $version
version = '2.00'
deck    = 'V2_00'
ctot [deck]
shel mv [deck].txt V[version]_dev.txt

shell echo { > convert.dat
shell echo gHtml = new THtml\(\)\//';'  >> convert.dat
shell echo gHtml.Convert\(\"/user/brun/root/V[version]_dev.txt\",\"ROOT Version [version] Development Notes\"\)\//';'  >> convert.dat
shell echo } >> convert.dat

shell root.exe -b -q convert.dat

shell /bin/rm V[version]_dev.txt
shell /bin/rm convert.dat

exec install_changelog

shell ftpchangelog

cd [curdir]
return
