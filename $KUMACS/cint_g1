macro cint_g1
*
*    To generate the dictionary (part 1) for all graphics classes
*    ===================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TAttPad.h TAttCanvas.h TArc.h TArrow.h TBox.h TColor.h TDiamond.h _
        TEllipse.h TFrame.h TGaxis.h TGraph.h TGraphErrors.h TGraphAsymmErrors.h _
        TLatex.h TLine.h TMarker.h TPolyLine.h TPolyMarker.h TText.h TPave.h _
        TPaveLabel.h TPaveText.h TPavesText.h TF1.h TF2.h TF3.h TWbox.h

name=Graf1
patch=G

set G__LinkDef.h -F TEXT
ctot /$kumacs/G1_LinkDef

exec makecint [name] [patch] [headers]

return
