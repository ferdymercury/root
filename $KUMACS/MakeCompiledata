macro makecompiledata
* macro to generate the compiledata.h file

import *

* get rid of trailing '-c'
opts = $SUBSTRING([CXXOPT],1, $INDEX([CXXOPT],' -c'))

+IF,WIN32.
  shell remove src\compiledata.h
  shell remove include\compiledata.h
  shell echo #define MAKESHAREDLIB " " > src\compiledata.h
  shell echo #define MAKEEXE " " >> src\compiledata.h
  shell echo #define INCLUDEPATH "-I'$ROOTSYS'/include" >> src\compiledata.h
  shell echo #define LINKEDLIBS "[LIBS]" >> src\compiledata.h
  shell echo #define SOEXT "dll" >> src\compiledata.h
  shell echo #define OBJEXT "obj" >> src\compiledata.h
+ELSE
  shell echo \#define MAKESHAREDLIB \"[CXX] [opts]\ '$IncludePath'\ '$SourceFiles'\ [SLOPT]\ '$SharedLib'\" > compiledata.h
  shell echo \#define MAKEEXE \"[CXX] [opts]\ '$IncludePath'\ '$SourceFiles'\ -o '$ExeName'\ '$LinkedLibs'\" >> compiledata.h
  shell echo \#define INCLUDEPATH \"-I'$ROOTSYS'/include\" >> compiledata.h
  shell echo \#define LINKEDLIBS \"[LIBS]\" >> compiledata.h
  shell echo \#define OBJEXT \"o\" >> compiledata.h
  if [machine] = 'HPUX' then
     shell echo \#define SOEXT \"sl\" >> compiledata.h
  elseif [machine] = 'IBMRT' then
     shell echo \#define SOEXT \"a\" >> compiledata.h
  elseif [machine] = 'WinNT' then
     shell echo \#define SOEXT \"dll\" >> compiledata.h
  else
     shell echo \#define SOEXT \"so\" >> compiledata.h
  endif

  shell mv compiledata.h src/compiledata.h
+ENDIF
return
