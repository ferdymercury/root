macro cint_rfio
*
*    To generate the dictionary for the RFIO classes
*    ===============================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h


headers=TRFIOFile.h

name=RFIO
patch=RFIO

set G__LinkDef.h -F TEXT
ctot /$kumacs/RFIO_LinkDef

exec makecint [name] [patch] [headers]

return
