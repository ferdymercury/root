macro cint_rint
*
*    To generate the dictionary for the RINT (ROOT/CINT) interpreter
*    ===============================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TRint.h TTabCom.h

name=Rint
patch=RINT

set G__LinkDef.h -F TEXT
ctot /$kumacs/RINT_LinkDef

exec makecint [name] [patch] [headers]

return
