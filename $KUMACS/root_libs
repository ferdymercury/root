macro root_libs
* to build all small root libraries
* be careful when specifying the list of libs with wildcards
* because of Windows95 limitations, a maximum of 4 characters may be given

if $MACHINE = 'IBMRT' then

*-- For platforms of which the linker requires all symbols to be resolved

bind_lib Core          {BASE,CONT,META,NET,UNIX,ZIP,C}_*.o
bind_lib New           NEW_*.o
bind_lib Hist          H_*.o
bind_lib Tree          TREE_*.o
bind_lib Graf          G_*.o       -lHist
bind_lib Gpad          GPAD_*.o    -lGraf -lHist
bind_lib Graf3d        G3D_*.o     -lGraf -lHist
bind_lib GX11          X11_*.o     [LIBSX]
bind_lib Gui           GUI_*.o     -lGpad -lGraf -lGX11
bind_lib Matrix        MATRIX_*.o
bind_lib Minuit        MINU*.o
bind_lib HistPainter   HISTPA*.o   -lGraf -lHist
bind_lib Proof         PROOF_*.o   -lTree -lHist
bind_lib TreePlayer    TREEPL*.o   -lTree -lProof -lGraf -lGraf3d -lHist
bind_lib TreeViewer    TREEVI*.o   -lTree -lGraf -lHist -lGpad
bind_lib X3d           X3D_*.o     -lGraf3d -lX11
bind_lib Physics       PHYSICS_*.o
bind_lib Postscript    POST*.o
bind_lib Rint          RINT_*.o
bind_lib Html          HTML_*.o
bind_lib EG            EG_*.o      -lGraf -lGraf3d
+IF,PYTHIA.
bind_lib EGPythia      PYTHIA_*.o  -lEG  -lPythia
bind_lib EGPythia6     PYTHIA6_*.o -lEG  -lPythia6
+ENDIF
+IF,VENUS.
bind_lib EGVenus       VENUS_*.o   -lVenus
+ENDIF
+IF,THREAD.
bind_lib Thread        THRE*.o     [LIBST]
+ENDIF
+IF,GL.
bind_lib RGL           GL*.o
+ENDIF.
+IF,X11TTF.
bind_lib GX11TTF       X11TTF_*.o  -lGX11 -lttf -lX11
+ENDIF
+IF,RFIO.
bind_lib RFIO          RFIO_*.o    $RFIO
+ENDIF

+IF,STAR.
bind_lib STAR          STAR_*.o
+ENDIF
else

*-- For platforms of which the linker allows unresolved symbols

+IF,-WIN32.
+IF,VMS
  bind_lib Core        {BASE,CONT,META,NET,VMS,ZIP,C}_*.o
  bind_lib GX11        X11_*.o
+ELSE
  bind_lib Core        {BASE,CONT,META,NET,UNIX,ZIP,C}_*.o
  bind_lib GX11        X11_*.o      [LIBSX]
+ENDIF

+ELSE
  bind_lib Core        {BASE,CONT,META,NET,WINNT,ZIP,C}_*.o
  bind_lib WIN32       WIN3*.o
+ENDIF.

bind_lib New           NEW_*.o
bind_lib Hist          H_*.o
bind_lib Tree          TREE_*.o
bind_lib Graf          G_*.o
bind_lib Gpad          GPAD_*.o
bind_lib Graf3d        G3D_*.o
bind_lib Gui           GUI_*.o
bind_lib Matrix        MATRIX_*.o
bind_lib Minuit        MINU*.o
bind_lib HistPainter   HISTPA*.o
bind_lib TreePlayer    TREEPL*.o
bind_lib TreeViewer    TREEVI*.o
bind_lib X3d           X3D_*.o
bind_lib Physics       PHYSICS_*.o
bind_lib Postscript    POST*.o
bind_lib Rint          RINT_*.o
bind_lib Html          HTML_*.o
bind_lib Proof         PROOF_*.o
bind_lib EG            EG_*.o
+IF,PYTHIA.
bind_lib EGPythia      PYTHIA_*.o
bind_lib EGPythia6     PYTHIA6_*.o
+ENDIF
+IF,VENUS.
bind_lib EGVenus       VENUS_*.o
+ENDIF
+IF,THREAD.
bind_lib Thread        THRE*.o      [LIBST]
+ENDIF
+IF,GL.
bind_lib RGL           GL*.o
+ENDIF.
+IF,X11TTF.
bind_lib GX11TTF       X11TTF_*.o
+ENDIF
+IF,RFIO.
bind_lib RFIO          RFIO_*.o     $RFIO
+ENDIF

+IF,STAR.
bind_lib STAR          STAR_*.o
+ENDIF

+IF,WIN32.
* Windows system needs the second pass to build the DLL's
+IF,NEWBIND.   ------------------------------------------------
exec bind_dll Core          *
exec bind_dll New           NEW_*.o
exec bind_dll Hist          H_*.o
exec bind_dll Tree          TREE_*.o
exec bind_dll Graf          G_*.o     $ROOTSYS\lib\Root_Hist.lib
exec bind_dll Gpad          GPAD_*.o  $ROOTSYS\lib\Root_Graf.lib $ROOTSYS\lib\Root_Hist.lib
exec bind_dll Graf3d        G3D_*.o   $ROOTSYS\lib\Root_Graf.lib $ROOTSYS\lib\Root_Hist.lib
exec bind_dll WIN32         WIN3*.o   $ROOTSYS\lib\Root_Graf.lib $ROOTSYS\lib\Root_Gpad.lib
exec bind_dll Gui           GUI_*.o   $ROOTSYS\lib\Root_Graf.lib $ROOTSYS\lib\Root_Gpad.lib
exec bind_dll Matrix        MATRIX_*.o
exec bind_dll Minuit        MINU*.o
exec bind_dll HistPainter   HISTPA*.o $ROOTSYS\lib\Root_Graf.lib $ROOTSYS\lib\Root_Hist.lib
exec bind_dll Proof         PROOF_*.o $ROOTSYS\lib\Root_Tree.lib $ROOTSYS\lib\Root_Hist.lib
exec bind_dll TreePlayer    TREEPL*.o $ROOTSYS\lib\Root_Tree.lib $ROOTSYS\lib\Root_Proof.lib _
                                      $ROOTSYS\lib\Root_Graf.lib $ROOTSYS\lib\Root_Graf3d.lib _
                                      $ROOTSYS\lib\Root_Hist.lib
exec bind_dll TreeViewer    TREEVI*.o $ROOTSYS\lib\Root_Tree.lib $ROOTSYS\lib\Root_Graf.lib _
                                      $ROOTSYS\lib\Root_Hist.lib $ROOTSYS\lib\Root_Gpad.lib
exec bind_dll X3d           X3D_*.o
exec bind_dll Physics       PHYS*.o
exec bind_dll Postscript    POST*.o
exec bind_dll Rint          RINT_*.o
exec bind_dll Html          HTML_*.o
exec bind_dll EG            EG_*.o    $ROOTSYS\lib\Root_Graf.lib $ROOTSYS\lib\Root_Graf3d.lib
+IF,PYTHIA.
exec bind_dll EGPythia      PYTHIA_*.o $ROOTSYS\lib\Root_EG.lib $PYTHIA\pythia.lib
exec bind_dll EGPythia6     PYTHIA6_*.o $ROOTSYS\lib\Root_EG.lib  $PYTHIA6\pythia6.lib
+ENDIF
+IF,VENUS.
exec bind_dll EGVenus       VENUS*.o  $ROOTSYS\lib\Root_EG.lib $VENUS\venus.lib
+ENDIF
+IF,GL.
exec bind_dll RGL           GL*.o     $ROOTSYS\lib\Root_Graf3d.lib $ROOTSYS\lib\Root_Win32.lib Glu32.lib OpenGL32.lib
+ENDIF.
+IF,STAR.
exec bind_dll STAR          STAR_*.o
+ENDIF.

+ELSE. not NEWBIND -----------------------------------------------------
exec bind_dll Core          *
exec bind_dll New           NEW_*.o
exec bind_dll Hist          H_*.o
exec bind_dll Tree          TREE_*.o
exec bind_dll Graf          G_*.o
exec bind_dll Gpad          GPAD_*.o
exec bind_dll Graf3d        G3D_*.o
exec bind_dll WIN32         WIN3*.o
exec bind_dll Gui           GUI_*.o
exec bind_dll Matrix        MATRIX_*.o
exec bind_dll Minuit        MINU*.o
exec bind_dll HistPainter   HISTPA*.o
exec bind_dll Proof         PROOF_*.o
exec bind_dll TreePlayer    TREEPL*.o
exec bind_dll TreeViewer    TREEVI*.o
exec bind_dll X3d           X3D_*.o
exec bind_dll Physics       PHYS*.o
exec bind_dll Postscript    POST*.o
exec bind_dll Rint          RINT_*.o
exec bind_dll Html          HTML_*.o
exec bind_dll EG            EG_*.o
+IF,PYTHIA.
exec bind_dll EGPythia      PYTHIA_*.o   $PYTHIA\pythia.lib
exec bind_dll EGPythia6     PYTHIA6_*.o  $PYTHIA6\pythia6.lib
+ENDIF
+IF,VENUS.
exec bind_dll EGVenus       VENUS*.o  $VENUS\venus.lib
+ENDIF
+IF,GL.
exec bind_dll RGL           GL*.o     $ROOTSYS\lib\Root_Graf3d.lib $ROOTSYS\lib\Root_Win32.lib Glu32.lib OpenGL32.lib
+ENDIF.
+IF,STAR.
exec bind_dll STAR          STAR_*.o
+ENDIF.
+ENDIF. end of NEWBIND ---------------------------------------------------
+ENDIF. end of WIN32

endif
return
