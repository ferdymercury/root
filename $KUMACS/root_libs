macro root_libs
* to build all small root libraries
* be careful when specifying the list of libs with wildcards
* because of Windows95 limitations, a maximum of 4 characters may be given

if $MACHINE = 'IBMRT' then
+IF,GCC.
*======================AIX with gcc machines==========================
application data bind_rootlib
#/bin/ksh
/usr/ccs/bin/nm -g -C \
$ROOTSYS/src/BASE_*.o \
$ROOTSYS/src/CONT_*.o \
$ROOTSYS/src/C_*.o \
$ROOTSYS/src/FUNC_*.o \
$ROOTSYS/src/G3D_*.o \
$ROOTSYS/src/GPAD_*.o \
$ROOTSYS/src/GUI_*.o \
$ROOTSYS/src/G_*.o \
$ROOTSYS/src/HTML_*.o \
$ROOTSYS/src/H_*.o \
$ROOTSYS/src/MATRIX_*.o \
$ROOTSYS/src/META_*.o \
$ROOTSYS/src/MINUIT_*.o \
$ROOTSYS/src/POSTSCRIPT_*.o \
$ROOTSYS/src/RINT_*.o \
$ROOTSYS/src/TREE_*.o \
$ROOTSYS/src/UNIX_*.o \
$ROOTSYS/src/PROOF_*.o \
$ROOTSYS/src/NET_*.o \
$ROOTSYS/src/X11_*.o \
$ROOTSYS/src/X3D_*.o \
$ROOTSYS/src/ZIP_*.o \
+IF,PYTHIA.
$ROOTSYS/src/PYTHIA_*.o \
+ENDIF
+IF,VENUS.
$ROOTSYS/src/VENUS_*.o \
+ENDIF
+IF,THREAD.
$ROOTSYS/src/THRE_*.o \
+ENDIF
$ROOTSYS/src/EG_*.o \
 | egrep " D "\|" B " | awk '{print $1}' > root.exp
gcc -o $ROOTSYS/lib/lib[1].a -shared -Wl,-bbigtoc -Wl,-bE:root.exp \
$ROOTSYS/src/BASE_*.o \
$ROOTSYS/src/CONT_*.o \
$ROOTSYS/src/C_*.o \
$ROOTSYS/src/FUNC_*.o \
$ROOTSYS/src/G3D_*.o \
$ROOTSYS/src/GPAD_*.o \
$ROOTSYS/src/GUI_*.o \
$ROOTSYS/src/G_*.o \
$ROOTSYS/src/HTML_*.o \
$ROOTSYS/src/H_*.o \
$ROOTSYS/src/MATRIX_*.o \
$ROOTSYS/src/META_*.o \
$ROOTSYS/src/MINUIT_*.o \
$ROOTSYS/src/POSTSCRIPT_*.o \
$ROOTSYS/src/RINT_*.o \
$ROOTSYS/src/TREE_*.o \
$ROOTSYS/src/UNIX_*.o \
$ROOTSYS/src/PROOF_*.o \
$ROOTSYS/src/NET_*.o \
$ROOTSYS/src/X11_*.o \
$ROOTSYS/src/X3D_*.o \
$ROOTSYS/src/ZIP_*.o \
+IF,PYTHIA.
$ROOTSYS/src/PYTHIA_*.o \
+ENDIF
+IF,VENUS.
$ROOTSYS/src/VENUS_*.o \
+ENDIF
+IF,THREAD.
$ROOTSYS/src/THRE_*.o \
+ENDIF
$ROOTSYS/src/EG_*.o \
   -L$ROOTSYS/lib -lCint -lXpm  -lstdc++ -lX11 -lm -lc
bind_rootlib

application data bind_newlib
#/bin/ksh
/usr/ccs/bin/nm -g -C \
$ROOTSYS/src/NEW_*.o \
 | egrep " D "\|" B " | awk '{print $1}' > new.exp
gcc -o $ROOTSYS/lib/libNew.a -shared -Wl,-bbigtoc -Wl,-bE:new.exp \
$ROOTSYS/src/NEW_*.o \
   -L$ROOTSYS/lib -lRoot -lCint -lXpm  -lstdc++ -lX11 -lm -lc
bind_newlib
   shell chmod +x bind_rootlib bind_newlib
   shell bind_rootlib
   shell bind_newlib
