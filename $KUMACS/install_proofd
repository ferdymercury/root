MACRO install_proofd 1=- 2=opt

import *

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif

if [machine] = 'IBMPC' then
   machine = 'WinNT'
   set install_proofd.bat -xarcl
endif

EXEC setup [1] [2] [LOGFILE]

SEL PROOFD
cd ..

CC proofd/proofd


if $AFS <> '$AFS' then
   extralibs = ' -L$AFS/lib -L$AFS/lib/afs -lkauth -lprot _
 -lubik -lauth -lrxkad -lsys -ldes -lrx -llwp -lcmd -lcom_err _
 -laudit $AFS/lib/afs/util.a'
else
   extralibs =
endif

+IF,GLIBC.
   extralibs = [extralibs]//' -lcrypt'
+ENDIF.

if [machine] = 'SOLARIS' .OR. [machine] = 'SOLARISPC' then
   extralibs = [extralibs]//' -lnsl -lsocket -lgen -L/usr/ucblib -lucb'
endif


main=$ROOTSYS/src/PROOFD_proofd.o

if [machine] = 'WinNT' then
+IF,SYMANTEC
   main=$ROOTSYS\src\PROOFD_proofd.obj
* LINK obj[, out[, map[, lib[, def[, res]]]]]
   exec LFLAGS
*  Set list of obj modules
   sh for %f in ($ROOTSYS\src\PROOFD_*.obj) do echo %f+ >> $ROOTSYS\bin\symantec.lnk
   sh echo $ROOTSYS\src\PROOFD_proofd.obj >> $ROOTSYS\bin\symantec.lnk
* Set output name of the exe file
   SH echo $ROOTSYS\bin\proofd.exe       >> $ROOTSYS\bin\symantec.lnk
   SH echo NUL                     >> $ROOTSYS\bin\symantec.lnk
   exec SystemLibs
   SH echo NUL                     >> $ROOTSYS\bin\symantec.lnk
   SH [LD] [LDOPT] @$ROOTSYS\bin\symantec.lnk
+ELSE
   main=$ROOTSYS\src\PROOFD_proofd.obj

   pdb = '$ROOTSYS\bin\proofd.pdb'

   sh [LD] [LDOPT] /pdb:[pdb] [main] /out:$ROOTSYS\bin\proofd.exe
+ENDIF
else
   SH [LD] [LDOPT] $ROOTSYS/bin/proofd [main] [extralibs]
endif

sel -PROOFD

RETURN
