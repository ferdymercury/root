macro cint_meta
*
*    To generate the dictionary for all meta classes
*    ===============================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=-DG__API TBaseClass.h TClass.h TDataMember.h TDataType.h TFunction.h _
        TGlobal.h TMethod.h TMethodArg.h TMethodCall.h TCint.h TInterpreter.h _
        TToggle.h TToggleGroup.h

name=Meta
patch=META

set G__LinkDef.h -F TEXT
ctot /$kumacs/META_LinkDef

exec makecint [name] [patch] [headers]

return
