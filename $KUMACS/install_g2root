MACRO install_g2root 1=- 2=opt

import *

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif

if [machine] = 'IBMPC' then
   machine = 'WinNT'
if [LOGFILE] = 'log' then
   set install_g2root.bat -xarcl
endif
endif

EXEC setup [1] [2] [LOGFILE]

SEL UTILS
cd ..

sysroot = $ROOTSYS
libcern = $CERNLIB
*libcern = /cern/pro/lib

set c c++ f77 -lan

Cx utils/g2root

+IF,WIN32.
+IF,SOURCE
   CX utils/cfget utils/cfgeto utils/cfopei utils/cfput utils/cfputo
+ELSE
   CC utils/cfget utils/cfgeto utils/cfopei utils/cfput utils/cfputo
+ENDIF.
+ENDIF.

+IF,SOURCE
   sel -utils
   return
+ENDIF

main=[sysroot]/src/UTILS_g2root.f

if [machine] = 'HPUX' then
   SH f77 +ppu -g -o [sysroot]/bin/g2root [main] _
        [libcern]/libpacklib.a [libcern]/libkernlib.a
elseif [machine] = 'IBMRT' then
   SH xlf -o g2root.o -c [main] -qextname -qcharlen=32767 -qrecur -qnosave
   SH xlC -o [sysroot]/bin/g2root g2root.o _
            [libcern]/libpacklib.a [libcern]/libkernlib.a _
            /usr/lib/libxlf.a /usr/lib/libxlf90.a
elseif [machine] = 'SOLARIS' .OR. [machine] = 'SOLARISPC' then
     mess g2root not yet ready for this system
     go to END
   sh cp -r [main] g2root.f
   SH f2c -a g2root.f > g2root.c
   SH cc -c g2root.c
   SH cc -o [sysroot]/bin/g2root [main] _
          [libcern]/libpacklib.a [libcern]/libkernlib.a _
          -lM77 -lF77 -lsunmath -lsocket -lnsl -lf2c
   SH /bin/rm -f g2root.*
elseif [machine] = 'SGI' then
     mess g2root not yet ready for this system
     go to END
   SH f2c -a g2root.f > g2root.c
   SH cc -c g2root.c
   SH f77 -o [sysroot]/bin/g2root [main] _
          [libcern]/libpacklib.a [libcern]/libkernlib.a _
          -lI77 -lF77 -lisam -lf2c
   SH /bin/rm -f g2root.*
elseif [machine] = 'ALPHA' then
   sh cp -r [main] g2root.f
   SH f2c -a g2root.f > g2root.c
   SH cc -c g2root.c
   SH cc -o [sysroot]/bin/g2root g2root.o _
          [libcern]/libpacklib.a [libcern]/libkernlib.a _
          /usr/shlib/libFutil.so /usr/shlib/libfor.so /usr/shlib/libots.so -lf2c
   SH /bin/rm -f g2root.*
elseif [machine] = 'LINUX' then
   sh cp -r [main] g2root.f
   SH f2c -a g2root.f > g2root.c
   SH gcc -c g2root.c
   SH fort77 -o [sysroot]/bin/g2root g2root.o _
          [libcern]/libpacklib.a [libcern]/libkernlib.a
   SH /bin/rm -f g2root.*
elseif [machine] = 'WinNT' then
  libcern = $CERNLIB

  cc utils/g2root

  SysLibs     =
  CernLibs    = [libcern]\packlib.lib
  UserObjDir  = [sysroot]\src
  MainObject  = [UserObjDir]\UTILS_g2root.obj [UserObjDir]\UTILS_setpawc.obj
  ForObject   = [UserObjDir]\UTILS_tzvers.obj [UserObjDir]\UTILS_cf*.obj
  UserLibDir  = [sysroot]\lib
  UserLibs    = [UserLibDir]\*.lib
  UserObjs    =
  ExeFile     = [sysroot]\bin\G2Root.exe

  pdb = '%ROOTSYS%\bin\G2Root_exe.pdb'

*  Sh [LD] [LDOPT] /PDB:[pdb] [LDOUTPUTOPT][ExeFile] [MainObject] [ForObject] [UserObjs] [UserLibs] [CernLibs] [SysLibs]
   Sh [F77] /MD /4Nportlib [MainObject] [ForObject] [UserObjs] [UserLibs] [CernLibs] [SysLibs] /link [LDOPT] /PDB:[pdb] [LDOUTPUTOPT][ExeFile]

else
     mess g2root not yet ready for this system
     go to END
   SH f77 -o [sysroot]/bin/g2root [main] _
        [libcern]/libpacklib.a [libcern]/libkernlib.a
endif

END:
sel -utils
set c c++ -lan

RETURN
