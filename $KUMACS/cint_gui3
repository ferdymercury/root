macro cint_gui3
*
*    To generate the dictionary for all gui classes
*    ==============================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*
seq -i src/*.h

headers=TRootGuiFactory.h TRootApplication.h TRootCanvas.h TRootBrowser.h _
        TRootContextMenu.h TRootDialog.h TRootControlBar.h TRootHelpDialog.h _
        TRootEmbeddedCanvas.h

name=Gui3
patch=GUI

set G__LinkDef.h -F TEXT
ctot /$kumacs/GUI3_LinkDef

exec makecint [name] [patch] [headers]

return
