MACRO install_rootd 1=- 2=opt

import *

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif

if [machine] = 'IBMPC' then
   machine = 'WinNT'
   set install_rootd.bat -xarcl
endif

EXEC setup [1] [2] [LOGFILE]

SEL ROOTD
cd ..

CC rootd/*


if $AFS <> '$AFS' then
   extralibs = ' -L$AFS/lib -L$AFS/lib/afs -lkauth -lprot _
 -lubik -lauth -lrxkad -lsys -ldes -lrx -llwp -lcmd -lcom_err _
 -laudit $AFS/lib/afs/util.a'
else
   extralibs =
endif

if $SRP <> '$SRP' then
   extralibs = [extralibs]//' -L$SRP/lib -lsrp -lgmp'
endif

+IF,GLIBC.
   extralibs = [extralibs]//' -lcrypt'
+ENDIF.

if [machine] = 'SOLARIS' .OR. [machine] = 'SOLARISPC' then
   extralibs = [extralibs]//' -lnsl -lsocket -lgen -L/usr/ucblib -lucb'
endif


main=$ROOTSYS/src/ROOTD_*.o

if [machine] = 'WinNT' then
+IF,SYMANTEC
   main=$ROOTSYS\src\ROOTD_*.obj
* LINK obj[, out[, map[, lib[, def[, res]]]]]
   exec LFLAGS
*  Set list of obj modules
   sh for %f in ($ROOTSYS\src\ROOTD_*.obj) do echo %f+ >> $ROOTSYS\bin\symantec.lnk
   sh echo $ROOTSYS\src\ROOTD_*.obj >> $ROOTSYS\bin\symantec.lnk
* Set output name of the exe file
   SH echo $ROOTSYS\bin\rootd.exe       >> $ROOTSYS\bin\symantec.lnk
   SH echo NUL                     >> $ROOTSYS\bin\symantec.lnk
   exec SystemLibs
   SH echo NUL                     >> $ROOTSYS\bin\symantec.lnk
   SH [LD] [LDOPT] @$ROOTSYS\bin\symantec.lnk
+ELSE
   main=$ROOTSYS\src\ROOTD_*.obj
* if [DEBUG] = 'yes' then
   pdb = '$ROOTSYS\bin\rootd.pdb'
* else
*   pdb = 'NONE'
* endif
   sh [LD] [LDOPT] /pdb:[pdb] [main] /out:$ROOTSYS\bin\rootd.exe
+ENDIF
else
   SH [LD] [LDOPT] $ROOTSYS/bin/rootd [main] [extralibs]
endif

sel -ROOTD

RETURN
