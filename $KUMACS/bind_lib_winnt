macro bind_lib_winnt 1='root'   2='*.obj'
* macro to generate a static library from the sources specified in par 2.

import *

message Generating library: $ROOTSYS\lib\Root_[1].lib
Mess Creating the export/import libraries

* Create module definition file
if [1] = 'Core' then
   shell $ROOTSYS\bin\BINDEXPLIB.exe Root_[1] [COREOBJS] > $ROOTSYS\lib\Root_[1].def
   shell lib /nologo /MACHINE:IX86 /out:$ROOTSYS\lib\Root_[1].lib [COREOBJS] /def:$ROOTSYS\lib\Root_[1].def
else
   shell $ROOTSYS\bin\BINDEXPLIB.exe Root_[1] $ROOTSYS\src\[2]* > $ROOTSYS\lib\Root_[1].def
   shell lib /nologo /MACHINE:IX86 /out:$ROOTSYS\lib\Root_[1].lib $ROOTSYS\src\[2]* /def:$ROOTSYS\lib\Root_[1].def
endif

return
