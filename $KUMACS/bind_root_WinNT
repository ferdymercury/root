macro bind_root_WinNT 1=-

import *

main=$ROOTSYS/src/MAIN_rmain.o

*----------------------Windows/NT case---------------------------------------

SysLibs     =
MainObject  = $ROOTSYS\src\main_rmain.obj
UDir        = $ROOTSYS\lib
UserLibs    = [UDir]\Root_New.lib  [UDir]\Root_Core.lib [UDir]\Root_Cint.lib _
              [UDir]\Root_Hist.lib [UDir]\Root_Graf.lib [UDir]\Root_Graf3d.lib _
              [UDir]\Root_Tree.lib [UDir]\Root_Rint.lib [UDir]\Root_Win32.lib

+IF,RootIcon.
UserObjs    = $ROOTSYS\Icons\RootIcon.obj
+ENDIF.

ExeFile     = /out:$ROOTSYS\bin\root.exe
LinkOptions = '/PDB:%ROOTSYS%\bin\Root_exe.pdb'

* ---> for static libs;    sh echo  $ROOTSYS\src\*G__* >> $ROOTSYS\bin\microsoft.lnk
+IF,RootIcon.
   Sh [LD] [LDOPT] [LinkOptions] [ExeFile] [MainObject] [UserObjs] [UserLibs] [SysLibs]
+ELSE
   Sh [LD] [LDOPT] [LinkOptions] [ExeFile] [MainObject] [UserLibs] [SysLibs]
+ENDIF.
*
* We should build the separate version of the executable for those want call Fortran subroutines too
* This executable module 'root4for' should be re-destributed with the MS Fortran DLL MSFRT40.DLL together
*
FortranIOLink =  $ROOTSYS\src\MAIN_Welcome.obj

+IF,RootIcon.
  UserObjs   = [UserObjs] [FortranIOLink]
+ELSE
  UserObjs   = [FortranIOLink]
+ENDIF.

ExeFile     = /out:$ROOTSYS\bin\root4for.exe
LinkOptions = '/PDB:%ROOTSYS%\bin\Root4for_exe.pdb'
   Sh [LD] [LDOPT] [LinkOptions] [ExeFile] [MainObject] [UserObjs] [UserLibs] [SysLibs]

return
