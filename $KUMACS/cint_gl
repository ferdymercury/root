macro cint_gl
*
*    To generate the dictionary for all GL classes
*    =============================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

sel GL
seq GL
seq -i src/*.h
sel -GL

+SELF,IF=-WIN32.
headers=TRootGL.h TRootGLU.h
+SELF,IF=WIN32.
headers= -DCALLBACK -DWINGDIAPI -DAPIENTRY TRootGLU.h
+SELF.

+SELF,IF=-WIN32.
name=GL
+SELF,IF=WIN32.
name=GLWIN32
+SELF
patch=GL

