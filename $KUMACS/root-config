#!/bin/sh

### ROOT version (string automatically provided by CMZ) ###

versdef="\
#include "VERSQQ.h"
"

### ROOT libraries ###

newlib="-lNew"
rootlibs="-lCore -lCint -lHist -lGraf -lGraf3d -lGpad -lTree -lRint \
          -lPostscript -lMatrix -lPhysics"
rootglibs="-lGui"

### machine dependent settings ###

+SELF,IF=HPUX,IF=-ACC,IF=-EGCS.
#HP-UX with CC
auxcflags="+a1 +Z"
auxlibs="-lm -ldld"
auxglibs=${auxlibs}

+SELF,IF=HPUX,IF=ACC.
# HP-UX 10.x with aCC
auxcflags="+W823"
auxlibs="-lm -ldld"
auxglibs=${auxlibs}

+SELF,IF=HPUX,IF=EGCS.
# HP-UX 10.x with g++
auxcflags=
auxlibs="-lm -ldld"
auxglibs=${auxlibs}

+SELF,IF=IBMRT,IF=-GCC.
# IBM AIX
auxcflags="-qnoro -qnoroconst -qmaxmem=-1"
auxlibs=
auxglibs=${auxlibs}

+SELF,IF=IBMRT,IF=GCC.
# IBM AIX with GCC
auxcflags="-fsigned-char"
auxlibs=
auxglibs=${auxlibs}

+SELF,IF=SOLARIS,IF=-GCC.
# Solaris
auxcflags=
auxlibs="-L/usr/ccs/lib -lm -lsocket -lgen -ldl -lsunmath"
auxglibs=${auxlibs}

+SELF,IF=SOLARIS,IF=GCC.
# Solaris
auxcflags=
auxlibs="-L/usr/ccs/lib -lg++ -lm -lsocket -lgen -ldl"
auxglibs=${auxlibs}

+SELF,IF=SOLARISPC.
# Solaris
auxcflags=
auxlibs="-L/usr/ccs/lib -lm -lsocket -lgen -ldl"
auxglibs=${auxlibs}

+SELF,IF=SGI,IF=-GCC,IF=-KCC,IF=-EGCS.
# SGI
auxcflags=
auxlibs="-lm -ldl"
auxglibs=${auxlibs}

+SELF,IF=SGI,IF=EGCS.
# SGI with EGCS
auxcflags="-fsigned-char"
auxlibs="-lstdc++ -lm"
auxglibs=${auxlibs}

+SELF,IF=SGI,IF=EGCS,IF=SGI64.
# SGI 6.4 with EGCS
auxcflags="-fsigned-char"
auxlibs="-lg++ -lm -lgen"
auxglibs=${auxlibs}

+SELF,IF=SGI,IF=GCC.
# SGI with GCC
auxcflags="-fsigned-char"
auxlibs="-lm -ldl"
auxglibs=${auxlibs}

+SELF,IF=SGI,IF=KCC.
# SGI with KCC
auxcflags="--signed_chars --display_error_number \
           --diag_suppress 68 --diag_suppress 191 --diag_suppress 837"
auxlibs="-lm -ldl"
auxglibs=${auxlibs}

+SELF,IF=ALPHA,IF=GCC.
# Alpha/OSF with g++
auxcflags=
auxlibs="-lg++ -lm"
auxglibs=${auxlibs}

+SELF,IF=ALPHA,IF=EGCS.
# Alpha/OSF with egcs
auxcflags="-mcpu=ev5 -D__osf__ -D__alpha"
auxlibs="-ltermcap -lm"
auxglibs=${auxlibs}

+SELF,IF=ALPHA,IF=KCC.
# Alpha/OSF with kai compiler (not yet valid)
auxcflags="-mcpu=ev5 -D__osf__ -D__alpha"
auxlibs="-ltermcap -lm"
auxglibs=${auxlibs}

+SELF,IF=ALPHA,IF=-GCC,IF=-EGCS,IF=-KCC,IF=CXX6.
# Alpha/OSF with cxx6
auxcflags="-nostdnew -D__osf__ -D__alpha"
auxlibs="-lm"
auxglibs=${auxlibs}

+SELF,IF=ALPHA,IF=-GCC,IF=-EGCS,IF=-KCC,IF=-CXX6.
# Alpha/OSF with cxx5
auxcflags="-oldcxx -D__osf__ -D__alpha"
auxlibs="-lm"
auxglibs=${auxlibs}

+SELF,IF=LINUX,IF=-EGCS,IF=-KCC.
# Linux with gcc 2.7.2.x
auxcflags=
auxlibs="-lg++ -lm -ldl -rdynamic"
auxglibs=${auxlibs}

+SELF,IF=LINUX,IF=EGCS.
# Linux with egcs
auxcflags=
auxlibs="-lm -ldl -rdynamic"
auxglibs=${auxlibs}

+SELF,IF=LINUX,IF=KCC.
# Linux with the KAI compiler
auxcflags="--signed_chars -D_EXTERN_INLINE=inline --diag_suppress 191"
auxlibs="-lm -ldl -rdynamic"
auxglibs=${auxlibs}

+SELF,IF=MkLinux.
# MkLinux with glibc
auxcflags="-fsigned-char -I/usr/X11/include  -I/usr/include/g++"
auxlibs="-lm -ldl -rdynamic"
auxglibs=${auxlibs}

+SELF,IF=HIUX.
# Hitachi HIUX
auxcflags=
auxlibs="-lm -ldld"
auxglibs=${auxlibs}

+SELF.
### end of machine dependent settings ###


prefix=$ROOTSYS
exec_prefix=${prefix}
exec_prefix_set=no
nonew_set=no

usage="\
Usage: root-config [--prefix[=DIR]] [--exec-prefix[=DIR]] [--version] [--nonew] [--libs] [--glibs] [--cflags]"

if test $# -eq 0; then
      echo "${usage}" 1>&2
      exit 1
fi

while test $# -gt 0; do
  case "$1" in
  -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
  *) optarg= ;;
  esac

  case $1 in
    --prefix=*)
      prefix=$optarg
      if test $exec_prefix_set = no ; then
        exec_prefix=$optarg
      fi
      ;;
    --prefix)
      echo $prefix
      ;;
    --exec-prefix=*)
      exec_prefix=$optarg
      exec_prefix_set=yes
      ;;
    --exec-prefix)
      echo $exec_prefix
      ;;
    --nonew)
      nonew_set=yes
      ;;
    --version)
      echo `echo $versdef | sed -e "s/^[A-Z= ]*' //" -e "s/'.*$//"`
      ;;
    --cflags)
      if test ${prefix}/include != /usr/include ; then
        includes=-I${prefix}/include
      fi
      echo ${auxcflags} $includes
      ;;
    --libs)
      if test $nonew_set = no ; then
        libs="${newlib} ${rootlibs}"
      else
        libs=${rootlibs}
      fi
      echo -L${exec_prefix}/lib $libs ${auxlibs}
      ;;
    --glibs)
      if test $nonew_set = no ; then
        glibs="${newlib} ${rootlibs} ${rootglibs}"
      else
        glibs="${rootlibs} ${rootglibs}"
      fi
      echo -L${exec_prefix}/lib $glibs ${auxglibs}
      ;;
    *)
      echo "${usage}" 1>&2
      exit 1
      ;;
  esac
  shift
done
