macro bind_rootlib 1=-
   SH /bin/rm -f $ROOTSYS/lib/root.slib
   SH CC -b -Wl,+s -o $ROOTSYS/lib/root.slib src/*.o
   SH chmod 555 $ROOTSYS/lib/root.slib
return
