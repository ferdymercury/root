macro install_others

cd ..
set c c++ f77 -lan

* sources common to all systems
sel cint
sel borland
cx cint/bcstrm
sel -borland
sel ibm
cx cint/dlfcn
sel -ibm
sel sun
cx cint/sunos
sel -sun
sel solaris cc5
cx cint/sunstrm
sel -solaris -cc5
sel kcc
cx cint/kccstrm
sel -kcc
sel eg
seq eg
cx eg
sel -eg
sel gl
seq gl
cx gl
sel -gl
sel thread posix
seq thread
cx thread
sel -thread
sel -posix

sel roots
seq roots
cx roots
sel -roots

sel star
seq starinc
cx star
sel -star

+IF,UNIX.
*      install WinNT and MAC sources
sel -unix
sel gl winnt win32 utils cint
seq incwin32 glwin32
cx winnt win32 glwin32
cx cint/vcstrm
cx cint/winnt
cx utils/setpawc
*
sel mac
cx mac cint/macos cint/fakestrm
sel -mac
sel vms
cx vms
sel -vms
sel -winnt -win32
sel unix
+ENDIF.

+IF,WIN32.
*      install UNIX and MAC sources
sel -win32 -winnt
sel gl unix utils cint
seq glx11
cx x11 unix
sel mac
cx mac cint/macos cint/fakestrm
sel -mac -unix
sel win32 winnt
+ENDIF.

+IF,MAC.
*      install UNIX and WinNT sources
sel -mac
sel gl unix winnt win32 utils cint
seq incwin32 glx11 glwin32
cx x11 unix
cx winnt win32
cx cint/vcstrm
cx cint/winnt
cx utils/setpawc
sel -unix -win32 -winnt
sel mac
+ENDIF.

sel -utils -cint
sel $MACHINE $OS

return
