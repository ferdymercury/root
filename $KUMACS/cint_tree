macro cint_tree
*
*    To generate the dictionary for all tree classes
*    ===============================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TTree.h TBranch.h TBranchClones.h TBranchObject.h TChain.h TChainElement.h _
        TLeaf.h TLeafObject.h  TLeafB.h TLeafI.h TLeafF.h TLeafS.h TLeafD.h _
        TLeafC.h TEventList.h TBasket.h TNtuple.h TCut.h TVirtualTreePlayer.h _
        TTreeResult.h TTreeRow.h

name=Tree
patch=TREE

set G__LinkDef.h -F TEXT
ctot /$kumacs/TREE_LinkDef

exec makecint [name] [patch] [headers]

return
