macro deleteall
mess deleting all decks in directory: $CWD()
godel:
do i = $NDECKS('?') , 2, -1
   deck = $DECKNAME([i])
* quoting string is necessary in case of special deck names like $TIME
   mess delete $QUOTE([deck])
   delete $QUOTE([deck])
enddo
if $NDECKS('?') > 1 then
   goto godel
endif
return
