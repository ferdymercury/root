macro bind_dll  1='root'   2='*.obj' 3='' 4='' 5='' 6='' 7='' 8='' 9=''
Mess Creating the Root_[1].dll DLL library
import *

*  Third parameter defines the list of the extra libraries
*  (OpenGl for example for WIN32 dlls)

LastSystemLib = COMCTL32.LIB
ExtraLibs = [LastSystemLib]

SysLibs = 'msvcrt.lib oldnames.lib '// _
          'kernel32.lib advapi32.lib '// _
          'user32.lib gdi32.lib comdlg32.lib winspool.lib '// _
          [ExtraLibs]

pdb = $ROOTSYS\bin\Root_[1].pdb

UserLibs = $ROOTSYS\lib\*.lib

+IF,NEWBIND
if [1] = 'Cint' then
  shell [LD] [SLOPT] /PDB:[pdb] [LDOUTPUTOPT]$ROOTSYS\bin\Root_[1].[DLLSUF] _
    $ROOTSYS\src\[2]* $ROOTSYS\lib\Root_[1].exp [SysLibs]
elseif [1] = 'Core' then
  shell [LD] [SLOPT] /PDB:[pdb] [LDOUTPUTOPT]$ROOTSYS\bin\Root_[1].[DLLSUF] _
    [COREOBJS] $ROOTSYS\lib\Root_[1].exp $ROOTSYS\lib\Root_Cint.lib [SysLibs] WSock32.lib
else
  shell [LD] [SLOPT] /PDB:[pdb] [LDOUTPUTOPT]$ROOTSYS\bin\Root_[1].[DLLSUF] _
    $ROOTSYS\src\[2]* $ROOTSYS\lib\Root_[1].exp [3] [4] [5] [6] [7] [8] [9] _
    $ROOTSYS\lib\Root_Core.lib $ROOTSYS\lib\Root_Cint.lib [SysLibs]
endif
+ELSE
if [1] = 'Cint' then
  shell [LD] [SLOPT] /PDB:[pdb] [LDOUTPUTOPT]$ROOTSYS\bin\Root_[1].[DLLSUF] _
    $ROOTSYS\src\[2]* $ROOTSYS\lib\Root_[1].exp  [UserLibs] [SysLibs]
elseif [1] = 'Core' then
  shell [LD] [SLOPT] /PDB:[pdb] [LDOUTPUTOPT]$ROOTSYS\bin\Root_[1].[DLLSUF] _
    [COREOBJS] $ROOTSYS\lib\Root_[1].exp [UserLibs] [SysLibs] WSock32.lib
else
  shell [LD] [SLOPT] /PDB:[pdb] [LDOUTPUTOPT]$ROOTSYS\bin\Root_[1].[DLLSUF] _
    $ROOTSYS\src\[2]* $ROOTSYS\lib\Root_[1].exp [3] [4] [5] [6] [7] [8] [9] _
    [UserLibs] [SysLibs]
endif
+ENDIF
return
