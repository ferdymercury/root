macro bind_dll  1='root'   2='*.obj' 3='-' 4='-' 5='-' 6='-'
Mess Creating the Root_[1].dll DLL library
import *

*  Third parameter defines the list of the extra libraries
*  (OpenGl for example for WIN32 dlls)

LastSystemLib = COMCTL32.LIB
ExtraLibs = [LastSystemLib]

if [3] <> '-' then
  ExtraLibs = [LastSystemLib]//' '//[3]
  if [4] <> '-' then
     ExtraLibs = [LastSystemLib]//' '//[3]//' '//[4]
     if [5] <> '-' then
        ExtraLibs = [LastSystemLib]//' '//[3]//' '//[4]//' '//[5]
        if [6] <> '-' then
          ExtraLibs = [LastSystemLib]//' '//[3]//' '//[4]//' '//[5]//' '//[6]
       endif
     endif
  endif
  Mess This DLL is linked with [ExtraLibs] libraries
endif

SysLibs = 'msvcrt.lib oldnames.lib '// _
          'kernel32.lib advapi32.lib '// _
          'user32.lib gdi32.lib comdlg32.lib winspool.lib '// _
          [ExtraLibs]

UserLibs = $ROOTSYS\lib\*.lib

pdb = $ROOTSYS\bin\Root_[1].pdb

shell [LD] [SLOPT] /PDB:[pdb] [LDOUTPUTOPT]$ROOTSYS\bin\Root_[1].[DLLSUF] $ROOTSYS\src\[2]* $ROOTSYS\lib\Root_[1].exp [UserLibs] [SysLibs]

return
