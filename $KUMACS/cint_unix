macro cint_unix
*
*    To generate the dictionary for all UNIX classes
*    ===============================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TUnixSystem.h

name=Unix
patch=UNIX

set G__LinkDef.h -F TEXT
ctot /$kumacs/UNIX_LinkDef

exec makecint [name] [patch] [headers]

return
