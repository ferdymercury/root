macro vhtml 1=-
*
*   To generate the HTML version of CMZ release notes
*
import *

curdir = $CWD()
cd $version
deck    = 'V2_'//$substring([RootVersion],3,2)
ctot [deck]
shell /bin/rm V[RootVersion].txt
shell /bin/rm convert.dat
shel mv [deck].txt V[RootVersion].txt

shell echo { > convert.dat
shell echo gSystem.Load\(\"libHtml\"\)';' >> convert.dat
shell echo gHtml = new THtml\(\)\//';'  >> convert.dat
shell echo gHtml.Convert\(\"/user/brun/root/V[RootVersion].txt\",\"ROOT Version [RootVersion] Release Notes\"\)\//';'  >> convert.dat
shell echo } >> convert.dat

shell root.exe -b -q convert.dat

*shell /bin/rm V[RootVersion].txt
*shell /bin/rm convert.dat

cd [curdir]
return
