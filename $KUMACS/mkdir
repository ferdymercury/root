MACRO mkdir 1=-

OS = $OS

if [OS]='VMS' then
   MESS 'Creating directory' [1]
   SH create/dir [1]
else
  if [1]='-' then
    MESS 'Mkdir: Illegal argument' [1]
  elseif $FEXIST([1]) = 0 then
    MESS 'Mkdir: Creating directory' [1]
    SH mkdir [1]
  endif
endif

RETURN
