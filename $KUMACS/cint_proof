macro cint_proof
*
*    To generate the dictionary for all PROOF classes
*    ================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TProof.h TProofServ.h TSlave.h

name=Proof
patch=PROOF

set G__LinkDef.h -F TEXT
ctot /$kumacs/PROOF_LinkDef

exec makecint [name] [patch] [headers]

return
