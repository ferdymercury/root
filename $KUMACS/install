macro install 1=- 2=opt  3=log

OS = $OS
if [OS] = 'WINNT' then
   remove $ROOTSYS\lib\*.lib
   remove $ROOTSYS\bin\*
   remove $ROOTSYS\src\*
   remove $ROOTSYS\tutorials\*
   exec mkdir $ROOTSYS\tutorials
   exec mkdir $ROOTSYS\src

elseif [OS] ='VMS' then
   sh delete/log $ROOTSYS[lib]*.lib;*
   sh delete/log $ROOTSYS[src]*.*;*
   sh delete/log $ROOTSYS[tutorials]*.*;*
   exec mkdir $ROOTSYS[tutorials]
   exec mkdir $ROOTSYS[src]
else
   remove $ROOTSYS/src
   remove $ROOTSYS/tutorials
   exec mkdir $ROOTSYS/tutorials
   exec mkdir $ROOTSYS/src
endif

if [OS] = 'WINNT' then
*
*   Install BINDEXPLIB utility to make Visual C++ import and export libraries
message ************************************
message *   Installing BINDEXPLIB utility
message ************************************
exec install_makeexdll [1] [2] [3]
endif
*
*   Install_cint first (ROOT requires access to some CINT includes)
message ************************************
message *   Installing cint
message ************************************
exec install_cint [1] [2] [3]
*
*  Install icons in $ROOTSYS/icons directory
message ************************************
message *   Installing icons
message ************************************
cd ..
exec exporticons
*
*   Install ROOT library and main program
exec makecompiledata
exec install_onlyroot [1] [2] [3]
*
*   Install ROOT tutorials
message ************************************
message *   Installing tutorials
message ************************************
cd ..
exec tutorials
*
*   Install rootx
message ************************************
message *   Installing rootx
message ************************************
cd ..
exec install_rootx [1] [2] [3]
*
*   Install rootcint
message ************************************
message *   Installing rootcint
message ************************************
cd ..
exec install_rootcint [1] [2] [3]
*
*   Install HBOOK to ROOT converter
message ************************************
message *   Installing h2root: the HBOOK to ROOT converter
message ************************************
exec install_h2root
*
*   Install GEANT to ROOT converter
message ************************************
message *   Installing g2root: the GEANT to ROOT converter
message ************************************
exec install_g2root
*
if [OS] <> 'WINNT' then
*
*   Install rootd
message ************************************
message *   Installing rootd: the remote ROOT daemon
message ************************************
exec install_rootd
*
*   Install proofd
message ************************************
message *   Installing proofd: the remote PROOF daemon
message ************************************
exec install_proofd
*
*   Install proofserv
message ************************************
message *   Installing proofserv: the remote PROOF server
message ************************************
exec install_proofserv
*
endif
*
*   Install ROOT test examples in directory test
message ************************************
message *   Installing test programs in directory test
message ************************************
exec install_test
*
*   Install non-compiled system dependent source files
message ************************************
message *   Installing non-compiled system dependent source files
message ************************************
exec install_others
*
*   Install LinkDef headers and Makefiles
message ************************************
message *   Installing LinkDef headers and Makefiles
message ************************************
exec install_linkdef
exec install_make
exec install_changelog
exec install_rootconfig

return
