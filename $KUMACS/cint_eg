macro cint_eg
*
*    To generate the dictionary for the event generator classes
*    ==========================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TGenerator.h TPrimary.h TAttParticle.h TParticlePDG.h TDatabasePDG.h _
        TParticle.h

name=EG
patch=EG

set G__LinkDef.h -F TEXT
ctot /$kumacs/EG_LinkDef

exec makecint [name] [patch] [headers]

return
