macro install_proofserv 1=-

import *

sel proofserv

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif

if [machine] = 'IBMPC' then
   machine = 'WinNT'
endif


if [machine] = 'WinNT' then
   set $ROOTSYS/src/MAIN_*.cxx -f C++
   set $ROOTSYS/src/MAIN_*.f -f f77
if [LOGFILE] = 'log' then
   set install_proofserv.bat -xarcl
endif
elseif [machine] = 'MAC' then
   set $ROOTSYS/src/MAIN_*.cxx -fe C++
else
   shell /bin/rm -f $ROOTSYS/bin/proofserv
   set $ROOTSYS/src/MAIN_*.cxx -f C++
endif

cd /proof
cc pmain

+IF,WIN32.
* We have to compile a dummy fortran routine to allow loading Fortran DLLs too
set f77 -lan
cd /winnt
cc welcome
cd /proof
set c c++ -lan
+ENDIF.

sel -proofserv
exe sourcedir [1]
exec bind_proofserv [1]

return
