macro cint_gui2
*
*    To generate the dictionary for all gui classes
*    ==============================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*
seq -i src/*.h

headers=TGObject.h TGScrollBar.h TGCanvas.h TGListBox.h TGComboBox.h _
        TGTab.h TGSlider.h TGPicture.h TGListView.h TGMimeTypes.h _
        TGFSContainer.h TGFileDialog.h TGStatusBar.h TGToolTip.h _
        TGTextView.h TGToolBar.h TGListTree.h TGText.h TGDoubleSlider.h

name=Gui2
patch=GUI

set G__LinkDef.h -F TEXT
ctot /$kumacs/GUI2_LinkDef

exec makecint [name] [patch] [headers]

return
