macro compiler 1=-  2=opt 3=log

import *

exec globals [1]  [2]  [3]

SET [CXXCOMP] -C C++
SET [CCCOMP]  -C C

*-- set custom F77 (did not want to specify F77COMP for all machines in GLOBALS)
machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif

if [machine] = 'IBMPC' then
   machine = 'WinNT'
endif

if [machine] = 'LINUX' .OR. [machine] = 'WinNT' then
   SET [F77COMP] -C F77
endif

return
