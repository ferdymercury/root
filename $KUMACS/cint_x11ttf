macro cint_x11ttf
*
*    To generate the dictionary for the X11TTF classes
*    =================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h


headers=TGX11TTF.h

name=X11TTF
patch=X11TTF

set G__LinkDef.h -F TEXT
ctot /$kumacs/X11TTF_LinkDef

exec makecint [name] [patch] [headers]

return
