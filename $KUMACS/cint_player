macro cint_player
*
*    To generate the dictionary for the tree player classes
*    ======================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TTreePlayer.h TPacketGenerator.h _
        TSelector.h TTreeFormula.h

name=TreePlayer
patch=TREEPLAYER

set G__LinkDef.h -F TEXT
ctot /$kumacs/TREEPLAYER_LinkDef

exec makecint [name] [patch] [headers]

return
