macro cint_html
*
*    To generate the dictionary for HTML classes
*    ===========================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=THtml.h

name=Html
patch=HTML

set G__LinkDef.h -F TEXT
ctot /$kumacs/HTML_LinkDef

exec makecint [name] [patch] [headers]

return
