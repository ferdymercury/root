macro bind_lib 1='root'   2='*.o' 3='' 4='' 5=''
* macro to generate a shared library from the sources specified in par 2.

message Generating library: $ROOTSYS/lib/lib[1].sl

shell /bin/rm -f $ROOTSYS/lib/lib[1].sl
shell aCC -b -z -o $ROOTSYS/lib/lib[1].sl $ROOTSYS/src/[2] [3] [4] [5]
shell chmod 555 $ROOTSYS/lib/lib[1].sl

return
