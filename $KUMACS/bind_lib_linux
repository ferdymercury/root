macro bind_lib 1='root'   2='*.o' 3='' 4='' 5='' 6=''
* macro to generate a shared library from the sources specified in par 2.

import *

message Generating library: $ROOTSYS/lib/lib[1].so

shell /bin/rm -f $ROOTSYS/lib/lib[1].so
shell [LD] -Wl,-soname,lib[1].so [SLOPT] $ROOTSYS/lib/lib[1].so $ROOTSYS/src/[2] [3] [4] [5] [6]
shell chmod 555 $ROOTSYS/lib/lib[1].so

return
