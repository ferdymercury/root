macro install_root 1=-

import *

OS = $OS
sel rint

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif

if [machine] = 'IBMPC' then
   machine = 'WinNT'
endif


if [machine] = 'WinNT' then
   set $ROOTSYS/src/MAIN_*.cxx -f C++
   set $ROOTSYS/src/MAIN_*.f -f f77
if [LOGFILE] = 'log' then
   set install_root.bat -xarcl
endif
elseif [machine] = 'MAC' then
   set $ROOTSYS/src/MAIN_*.cxx -fe C++
elseif [OS] = 'VMS' then
   shell purge/log $ROOTSYS[bin.root]
   set $ROOTSYS[src]MAIN_*.cxx -f C++
else
   shell /bin/rm -f $ROOTSYS/bin/root.exe
   set $ROOTSYS/src/MAIN_*.cxx -f C++
endif

cd /rint
+IF,SOURCE
   cx rmain
+ELSE
   cc rmain
+ENDIF

+IF,WIN32.
* We have to compile a dummy fortran routine to allow loading Fortran DLLs too
set f77 -lan
cd /winnt
+IF,SOURCE
   cx welcome
+ELSE
   cc welcome
+ENDIF
cd /rint
set c c++ -lan
+ENDIF.

sel -rint
exe sourcedir [1]
+IF,-SOURCE
   exec bind_root [1]
+ENDIF

return
