macro cint_net
*
*    To generate the dictionary for all NET classes
*    ===============================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TInetAddress.h TServerSocket.h TSocket.h TMessage.h TMonitor.h _
        TUrl.h TNetFile.h TWebFile.h MessageTypes.h TSQLServer.h _
        TSQLResult.h TSQLRow.h

name=Net
patch=NET

set G__LinkDef.h -F TEXT
ctot /$kumacs/NET_LinkDef

exec makecint [name] [patch] [headers]

return
