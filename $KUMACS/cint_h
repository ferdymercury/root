macro cint_h
*
*    To generate the dictionary for all histogram classes
*    ====================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TH1.h TH2.h TH3.h TPaveStats.h TProfile.h TSpectrum.h

name=Hist
patch=H

set G__LinkDef.h -F TEXT
ctot /$kumacs/H_LinkDef

exec makecint [name] [patch] [headers]

return
