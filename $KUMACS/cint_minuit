macro cint_minuit
*
*    To generate the dictionary for all MINUIT class
*    ===============================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TMinuit.h TFitter.h

name=Minuit
patch=MINUIT

set G__LinkDef.h -F TEXT
ctot /$kumacs/MINUIT_LinkDef

exec makecint [name] [patch] [headers]

return
