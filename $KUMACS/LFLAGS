macro LFLAGS 1=WinNT 2=- 3=-
* -----------------------------------------------------------------
* Parameters:
*   1  -  The type of the operating system
*   2  -  The type of the output module:
*         = DLL - means DLL module will be limked
*         otherwise the EXE module will be built
*   3  - The name of the indirect command file
*        by default: $ROOTSYS\bin\symantec.lnk
* -----------------------------------------------------------------
OS = $OS
if [OS] = 'WINNT' then
*  It sets the flags to Symantec linker
  lflgs = [3]
  if [3] = '-' then
    lflgs = $ROOTSYS\bin\symantec.lnk
  endif
  entryname = /ENTRY:_mainCRTStartup /BAS:4194304
  if [2] = 'DLL' then
    entryname =  /ENTRY:__DllMainCRTStartup@12 /BAS:268435456 /DO /DE
  endif
  sh echo /DE /CO /NOI /XN /NT /VERS:1.0 /A:512 [entryname] > [lflgs]

endif
return
