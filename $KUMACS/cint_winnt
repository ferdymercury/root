macro cint_winnt
*
*    To generate the dictionary for the Win/NT classes
*    =================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TWinNTSystem.h TWinNTInput.h

name=WinNT
patch=WINNT

set G__LinkDef.h -F TEXT
ctot /$kumacs/WINNT_LinkDef

exec makecint [name] [patch] [headers]

return
