macro cint_winnt
*
*    To generate the dictionary for the Win/NT classes
*    =================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TWinNTSystem.h

name=WinNT
patch=WINNT

application data G__LinkDef.h
#ifdef __CINT__

#pragma link off all globals;
#pragma link off all classes;
#pragma link off all functions;

#pragma link C++ class TWinNTSystem;
#pragma link C++ class TFdSet;

#endif
G__LinkDef.h


exec makecint [name] [patch] [headers]

return
