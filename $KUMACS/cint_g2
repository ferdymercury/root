macro cint_g2
*
*    To generate the dictionary (part 2) for all graphics classes
*    ===================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers= TLink.h TPoints.h TLatex.h TLegend.h TLegendEntry.h

name=Graf2
patch=G

set G__LinkDef.h -F TEXT
ctot /$kumacs/G2_LinkDef

exec makecint [name] [patch] [headers]

return
