macro install_onlyroot 1=- 2=opt

message ************************************
message *   Installing ROOT  [1] [2]
message ************************************

OS = $OS

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif

if [machine] = 'IBMPC' then
   remove $ROOTSYS\lib\*.lib
*   remove $ROOTSYS\bin\*.dll
   machine = 'WinNT'
elseif [0S] = 'VMS' then
   sh purge/log $ROOTSYS[lib]
else
*   remove $ROOTSYS/lib/*.sl $ROOTSYS/lib/*.so $ROOTSYS/lib/*.a $ROOTSYS/lib/root.slib
*   remove $ROOTSYS/lib/*.so  (ONLY one argument at the time)
endif

*sel .
seq .

*
*   Install ROOT libraries and main program
*
exec setup [1] [2] [LOGFILE]

if $XPM <> '$XPM' then
   remove $ROOTSYS/lib/libXpm.*
   shell cp $XPM/libXpm.* $ROOTSYS/lib
   shell chmod 555 $ROOTSYS/lib/libXpm.*
endif

if $FEXIST(ttf) = 1 then
   remove $ROOTSYS/lib/libttf.*
   shell cp ttf/lib/libttf.* $ROOTSYS/lib
   shell chmod 555 $ROOTSYS/lib/libttf.*
endif

cd /
if [machine] = 'WinNT' then
if [LOGFILE] = 'log' then
   set install_onlyroot.bat -xarcl
endif
+IF,SOURCE
   CX *
+ELSE
   CC *
   libs
+ENDIF
elseif [machine] = 'MAC' then
   CX *
else
+IF,SOURCE
   CX *
+ELSE
   CC *
   libs
+ENDIF
endif

exec install_root [1] [2]

message ************************************
message *   ROOT installation completed
message ************************************

return
