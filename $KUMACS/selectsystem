macro selectsystem 1=-

select $MACHINE

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif

if [machine] = 'IBMPC' then
   machine = 'WinNT'
endif

if $OS = 'VMS' then
  machine = 'VMS'
endif

if [machine] = 'HPUX' .OR. [machine] = 'IBMRT' .OR. [machine] = 'SOLARIS' .OR. _
   [machine] = 'SOLARISPC' .OR. [machine] = 'ALPHA' .OR. [machine] = 'SGI' _
   .OR. [machine] = 'SGI64' .OR. [machine] = 'LINUX' .OR. [machine] = 'HIUX' then
   sel UNIX
elseif [machine] = 'WinNT' then
   sel WinNT Win32 SWAP QF_MSOFT GL
elseif [machine] = 'MAC' then
   sel MAC
elseif [machine] = 'VMS' then
   sel VMS
else
   mess 'selectsystem: *** Unknown machine type ***'
endif

if [machine] = 'IBMRT' then
   select IBM
endif

return
