macro bind_proofserv 1=-

import *

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif
if [machine] = 'IBMPC' then
   machine = 'WinNT'
endif

main=$ROOTSYS/src/MAIN_pmain.o

*----------------------Windows/NT case---------------------------------------
if [machine] = 'WinNT' then
   exec bind_proofserv_WinNT
*--------------------------Unix case---------------------------------------
else
   SH [LD] [LDOPT] $ROOTSYS/bin/proofserv [main] [PLIBS]
endif

return
