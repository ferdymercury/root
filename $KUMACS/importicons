macro importicons
saveauthor = $AUTHOR()
AUTH IconsAuthor
filecase keep

cd icons
exec deleteall
if $OS = 'VMS' then
  cimp -a -t C++ [.icons]*.xpm
  cimp -a -t C++ [.icons]root.mimes
else
  cimp -a  -t C++ $ROOTSYS/icons/*.xpm
  cimp -a  -t C++ $ROOTSYS/icons/root.mimes
endif
pur
al

author [saveauthor]
return
