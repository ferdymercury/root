macro  MakeDistSourceWindows

import *

remove MakeDistSource.bat
shell echo 'set ROOTVERS=v[RootVersion]' > MakeDistSource.bat

shell echo 'set MACHINE=%PROCESSOR_ARCHITECTURE%' > MakeDistSource.bat
shell echo 'set OSREL=%OS%' > MakeDistSource.bat

shell echo 'set TYPE=%MACHINE%.%OSREL%.src' > MakeDistSource.bat

shell echo 'set TARFILE=root_%ROOTVERS%.%TYPE%.tar' > MakeDistSource.bat

shell echo 'cd %ROOTSYS%' > MakeDistSource.bat

*shell echo 'tar -cvf %TARFILE% src/*.h src/*.c src/*.cxx src/*.f cint  STARtest/*.C tutorials/.rootrc tutorials/*.C test/*.cxx test/*.h test/Makefile test/README' > MakeDistSource.bat
shell echo 'tar -cvf %TARFILE% src/*.h src/*.c src/*.cxx src/*.f cint tutorials/.rootrc tutorials/*.C test/*.cxx test/*.h test/Makefile test/README' > MakeDistSource.bat

shell echo 'gzip %TARFILE%' > MakeDistSource.bat
