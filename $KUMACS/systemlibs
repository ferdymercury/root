macro SystemLibs 2=WinNT 3=- UserLibs=-

* -----------------------------------------------------------------
*  It sets the list of the compiler run-time libraries
*  [1]  - The name of the target system
*  [2]  - the name of the indirect file to hold the linker options
* -----------------------------------------------------------------

lflgs = [2]
if [2] = '-' then
  lflgs = $ROOTSYS\bin\symantec.lnk
endif

ListLibs = [UserLibs]
if [UserLibs] = '-' then
ListLibs =
endif

OS = $OS
if [OS] = 'WINNT' then
  sh echo [ListLibs] SNN.LIB COMCTL32.LIB COMDLG32.LIB CTL3D32.LIB KERNEL32.LIB GDI32.LIB USER32.LIB >>[lflgs]
endif

return
