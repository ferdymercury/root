macro bind_lib_SYMANTEC 1='root'   2='*.obj'
* macro to generate a static library from the sources specified in par 2.

message Generating library: $ROOTSYS\lib\Root_[1].lib

shell echo $ROOTSYS\lib\Root_[1].lib /c /n /p:64  > creatlib.tmp
if $PROCESSOR_ARCHITECTURE = 'x86' then
   shell for %f in ($ROOTSYS\src\[2]*) do echo +%f  ^& >>creatlib.tmp
else
   shell for %f in ($ROOTSYS\src\[2]*) do echo +%f  & >>creatlib.tmp
endif
shell echo ,nul >> creatlib.tmp
shell lib @creatlib.tmp

return
