macro install_roots 1=-

import *

sel roots

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif

if [machine] = 'IBMPC' then
   machine = 'WinNT'
endif



cd /roots
cc *

+IF,WIN32.
* We have to compile a dummy fortran routine to allow loading Fortran DLLs too
set f77 -lan
cd /winnt
cc welcome
cd /rint
set c c++ -lan
+ENDIF.

sel -roots
exe sourcedir [1]

main=$ROOTSYS/src/ROOTS_*.o

*----------------------Windows/NT case---------------------------------------
if [machine] = 'WinNT' then
*   exec bind_roots_WinNT
*--------------------------Unix case---------------------------------------
else
   SH [LD] [LDOPT] $ROOTSYS/bin/roots [main] [LIBSGUI]
endif

return
