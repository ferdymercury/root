macro bind_root 1=-

import *

machine = [1]
if [machine] = '-' then
   machine = $MACHINE
endif
if [machine] = 'IBMPC' then
   machine = 'WinNT'
endif

main=$ROOTSYS/src/MAIN_rmain.o

*----------------------Windows/NT case---------------------------------------
if [machine] = 'WinNT' then
   exec bind_root_WinNT
*--------------------------Unix case---------------------------------------
else
  if $OS = 'VMS' then
     exec bind_root_vms
  else
     SH [LD] [LDOPT] $ROOTSYS/bin/root.exe [main] [LIBS]
  endif
endif

return
