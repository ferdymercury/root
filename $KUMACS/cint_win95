macro cint_win95
*
*    To generate the dictionary for the Win95 classes
*    ================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TWin95System.h

name=Win95
patch=WIN95

application data G__LinkDef.h
#ifdef __CINT__

#pragma link off all globals;
#pragma link off all classes;
#pragma link off all functions;

#pragma link C++ class TWin95System;

#endif
G__LinkDef.h


exec makecint [name] [patch] [headers]

return
