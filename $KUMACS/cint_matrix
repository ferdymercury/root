macro cint_matrix
*
*    To generate the dictionary for all matrix classes
*    =================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*
seq -i src/*.h

headers=TVector.h TMatrix.h TMatrixUtils.h

name=Matrix
patch=MATRIX

set G__LinkDef.h -F TEXT
ctot /$kumacs/MATRIX_LinkDef

exec makecint [name] [patch] [headers]

return
