macro cint_ps
*
*    To generate the dictionary  for the TPostScript class
*    =====================================================
*
* Only change the [headers], [name] and [patch] variables and the
* "#pragma ..." statements.
*

seq -i src/*.h

headers=TPostScript.h

name=PostScript
patch=POSTSCRIPT

set G__LinkDef.h -F TEXT
ctot /$kumacs/PostScript_LinkDef

exec makecint [name] [patch] [headers]

return
