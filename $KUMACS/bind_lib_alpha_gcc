macro bind_lib_alpha_gcc 1='root'   2='*' 3='' 4='' 5=''
* macro to generate a shared library from the sources specified in par 2.

message Generating library: $ROOTSYS/lib/lib[1].so

import *

shell /bin/rm -f $ROOTSYS/lib/lib[1].so
if [1] = 'Core' then
   shell g++ -shared -Wl,-soname,lib[1].so -o $ROOTSYS/lib/lib[1].so [COREOBJS] [3] [4] [5]
else
   shell g++ -shared -Wl,-soname,lib[1].so -o $ROOTSYS/lib/lib[1].so $ROOTSYS/src/[2] [3] [4] [5]
endif
shell chmod 555 $ROOTSYS/lib/lib[1].so

return
