# Makefile of ROOT for Linux gcc 2.7.x.x with glibc

PLATFORM      = linux

CXX           = g++
CC            = gcc
CXXFLAGS      = -Wall -fPIC -DR__GLIBC
CFLAGS        = -Wall -fPIC -DR__GLIBC
CINTCXXFLAGS  = -Wall -fPIC -DG__REGEXP -DG__UNIX -DG__SHAREDLIB \
                -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO
CINTCFLAGS    = -Wall -fPIC -DG__REGEXP -DG__UNIX -DG__SHAREDLIB \
                -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO
OPT           = -O
NOOPT         =
LD            = g++
LDFLAGS       = $(OPT)
SOFLAGS       = -shared -Wl,-soname,
SOEXT         = so
SYSLIBS       = -lg++ -lm -ldl -rdynamic
SYSXLIBS      = -L/usr/X11R6/lib -lX11 -lg++ -lm -ldl -rdynamic
XLIBS         = $(ROOTSYS)/lib/libXpm.a -L/usr/X11R6/lib -lX11 -lg++
CILIBS        = -lm -ltermcap -lbsd -ldl -lg++ -rdynamic
CRYPTLIBS     =
F77           = fort77
F77FLAGS      = $(OPT) -Nx800 -NC200
F77LIBS       =

VPATH         = $(ROOTSYS)/include


##### MACROS and TARGETS #####

include Make-macros


##### DEPENDENCIES #####

include Make-depend

