# Top level Makefile for ROOT

include Makefile.config

.EXPORT_ALL_VARIABLES:
.PHONY: depend

default:
	@(if [ ! -f .depend ] ; then \
	   echo "Please, run 'make depend' first"; \
	   exit 1;\
	fi)
	@(if [ ! -f Makefile.config ] ; then \
	   echo "Please, run ./configure first"; \
	   exit 1; \
	fi)
	cd src ; $(MAKE) -f Makefile.$(ARCH)

depend:
	cd src ; $(MAKE) -f Make-macros depend
	echo "depend" > .depend

clean:
	cd src ; $(MAKE) -f Make-macros clean ; rm -f *.o
	rm -f *~ .depend

realclean:
	cd src ; $(MAKE) -f Make-macros distclean ; rm -f *.o
	rm -f *~ .depend

distclean:
	cd src ; $(MAKE) -f Make-macros distclean ; rm -f *.o
	rm -f *~ Makefile.config .depend


install:
	@echo "Making directories"
	@$(INSTALLDIR) $(BINDIR)
	@$(INSTALLDIR) $(LIBDIR)
	@$(INSTALLDIR) $(INCDIR)
	@$(INSTALLDIR) $(ETCDIR)
	@$(INSTALLDIR) $(DATADIR)
	@$(INSTALLDIR) $(MACRODIR)
	@$(INSTALLDIR) $(SRCDIR)
	@$(INSTALLDIR) $(ICONPATH)
	@$(INSTALLDIR) $(CINTINCDIR)
	@$(INSTALLDIR) $(CINTINCDIR)/include
	@$(INSTALLDIR) $(CINTINCDIR)/lib
	@$(INSTALLDIR) $(CINTINCDIR)/stl
	@$(INSTALLDIR) $(DOCDIR)
	@$(INSTALLDIR) $(TESTDIR)
	@$(INSTALLDIR) $(TUTDIR)
	@echo "Installing from src/"
	@cd src ; $(MAKE) -f Makefile.$(ARCH) install
	@echo "Installing various files"
	@$(INSTALL)     bin/rmkdepend      $(BINDIR)
	@$(INSTALL)     bin/root-config    $(BINDIR)
	@$(INSTALLDATA) cint/include/*     $(CINTINCDIR)/include/
	@$(INSTALLDATA) cint/lib/*         $(CINTINCDIR)/lib/
	@$(INSTALLDATA) cint/stl/*         $(CINTINCDIR)/stl/
	@$(INSTALLDATA) icons/root.mimes   $(ETCDIR)/root.mimes
	@$(INSTALLDATA) icons/*            $(ICONPATH)
	@$(INSTALLDATA) macros/*           $(MACRODIR)
	@$(INSTALLDATA) test/*             $(TESTDIR)
	@$(INSTALLDATA) tutorials/.rootrc  $(ETCDIR)/system.rootrc
	@$(INSTALLDATA) tutorials/*	   $(TUTDIR)
	@$(INSTALLDATA) AA_* ChangeLog	   $(DOCDIR)
	@echo "Installation done"
