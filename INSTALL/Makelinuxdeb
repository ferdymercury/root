# Makefile of ROOT for Linux (Debian) with glibc and egcs

# next line: jr
#ROOTSYS       = /home/jens/debian/root
PLATFORM      = linux

CXX           = g++
CC            = gcc
CXXFLAGS      = -Wall -fPIC -DR__GLIBC
CFLAGS        = -Wall -fPIC -DR__GLIBC
CINTCXXFLAGS  = -Wall -fPIC -DG__REGEXP \
                -DG__UNIX -DG__SHAREDLIB -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO
CINTCFLAGS    = -Wall -fPIC -DG__REGEXP -DG__UNIX -DG__SHAREDLIB \
                -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO
OPT           = -g -O2
NOOPT         =
LD            = g++
LDFLAGS       = $(OPT)
SOFLAGS       = -shared -Wl,-soname,
SOEXT         = so
SYSLIBS       = -lm -ldl -rdynamic
SYSXLIBS      = -L/usr/X11R6/lib -lX11 -lm -ldl -rdynamic
# jr XLIBS         = $(ROOTSYS)/lib/libXpm.a -L/usr/X11R6/lib -lX11
XLIBS         = -lXpm -L/usr/X11R6/lib -lX11
# jr CILIBS        = -lm -ltermcap -lbsd -ldl -rdynamic
CILIBS        = -lm -lncurses -ldl -rdynamic


##### MACROS and TARGETS #####

include Make-macros


##### DEPENDENCIES #####

include Make-depend

