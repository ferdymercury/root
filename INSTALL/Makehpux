# Makefile of ROOT for HP-UX 10.20 with CC

PLATFORM      = hpux

# if system is not HP-UX10.20 (eg, HP-UX 9.05) add -Dhpux9 to CXXFLAGS
CXX           = CC
CC            = cc
CXXFLAGS      = +a1 -z +Z -I/usr/include/X11R5
CFLAGS        = -Ae -z +Z -I/usr/include/X11R5
CINTCXXFLAGS  = +a1 -z +Z -I/opt/CC/include -DG__REGEXP -DG__UNIX -DG__HPUXCPPDLL \
                -DG__SHAREDLIB -D_POSIX2_SOURCE -DG__ROOT -DG__REDIRECTIO
CINTCFLAGS    = -Ae -z +Z -I/opt/CC/include -DG__REGEXP -DG__UNIX -DG__HPUXCPPDLL \
                -DG__SHAREDLIB -D_POSIX2_SOURCE -DG__ROOT -DG__REDIRECTIO
OPT           = -O
NOOPT         =
LD            = CC
LDFLAGS       = $(OPT) +a1 -z -Wl,+s -Wl,-E
SOFLAGS       = -b
SOEXT         = sl
SYSLIBS       = -lm -ldld
SYSXLIBS      = -L/usr/lib/X11R5 -lX11 -lm -ldld
XLIBS         = $(ROOTSYS)/lib/libXpm.a -L/usr/lib/X11R5 -lX11
CILIBS        = -lm -Wl,-E -ldld -lcurses
CRYPTLIBS     =
F77           = f77
F77FLAGS      = $(OPT) -K +ppu
F77LIBS       =

VPATH         = $(ROOTSYS)/include


##### MACROS and TARGETS #####

include Make-macros


##### DEPENDENCIES #####

include Make-depend

