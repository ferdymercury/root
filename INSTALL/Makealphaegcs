# Makefile to build ROOT for DEC unix with egcs1.1

PLATFORM      = alphaegcs

# OPT         = -g
OPT           = -O2
NOOPT         =

# Compiler:
CXX           = g++
CC            = gcc
CXXFLAGS      = -fPIC -mcpu=ev5 -D__osf__ -D__alpha
CFLAGS        = -fPIC -mcpu=ev5
CINTCXXFLAGS  = -fPIC -mcpu=ev5 \
                -DG__REGEXP -DG__UNIX -DG__SHAREDLIB \
                -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO
CINTCFLAGS    = -fPIC -mcpu=ev5 -DG__REGEXP -DG__UNIX -DG__SHAREDLIB \
                -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO

# Linker:
LD            = g++
LDFLAGS       =
SOFLAGS       = -Wl,-expect_unresolved,* -shared
SOEXT         = so

# System libraries:
SYSLIBS       = -lm -ltermcap
SYSXLIBS      = -lX11 -lm -ltermcap
XLIBS         = -L$(LPATH) -lXpm -lX11
CILIBS        = -lm -ltermcap
F77LIBS       = /usr/shlib/libFutil.so /usr/shlib/libfor.so /usr/shlib/libots.so


##### MACROS and TARGETS #####

include Make-macros


##### DEPENDENCIES #####

include Make-depend
