# Makefile of ROOT for SGI IRIX 6.4 with EGCS compiler
# contributed by Martin Weber

include ../Makefile.config

PLATFORM      = sgi

CXX           = g++
CC            = gcc
CXXFLAGS      = -fsigned-char -Wall -fPIC -I$(OPENGL)/include $(EXTRA_CXXFLAGS) \
                -DIRIX64
CFLAGS        = -fsigned-char -fPIC -Wall $(EXTRA_CFLAGS)
CINTCXXFLAGS  = -fsigned-char -Wall -fPIC -DG__REGEXP1 \
                -DG__UNIX -DG__SIGNEDCHAR -DG__SHAREDLIB -DG__OSFDLL \
                -DG__ROOT -DG__REDIRECTIO $(EXTRA_CXXFLAGS)
CINTCFLAGS    = -fsigned-char -fPIC -Wall -DG__REGEXP1 -DG__SIGNEDCHAR -DG__UNIX \
                -DG__SHAREDLIB -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO $(EXTRA_CFLAGS)
OPT           = -O
NOOPT         =
LD            = g++ $(EXTRA_LDFLAGS)
LDFLAGS       = $(OPT) -lm -L/usr/lib32
SOFLAGS       = -shared
SOEXT         = so
SYSLIBS       = -lm -ldl
XLIBS         = -L../lib -lXpm  -L/usr/lib32 -lX11
CILIBS        = -lm -lgen


##### MACROS and TARGETS #####

include Make-macros


##### DEPENDENCIES #####

include Make-depend

