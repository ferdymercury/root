#! /bin/sh

# Script to generate a shared library.
# Called by $ROOTSYS/src/Make-macros, the makefile backend.

PLATFORM=$1
LD=$2
LDFLAGS=$3
SOFLAGS=$4
SONAME=$5
LIB=$6
OBJS=$7
EXTRA=$8

rm -f $LIB

if [ $PLATFORM = aix ]; then
   echo this is aix
elif [ $PLATFORM = hpux ]; then
   echo $LD $SOFLAGS $LDFLAGS -o $LIB $OBJS $EXTRA
   $LD $SOFLAGS $LDFLAGS -o $LIB $OBJS $EXTRA
elif [ $PLATFORM = solaris ]; then
   echo $LD $SOFLAGS $LDFLAGS -o $LIB $OBJS $EXTRA
   $LD $SOFLAGS $LDFLAGS -o $LIB $OBJS $EXTRA
elif [ $PLATFORM = sgi ]; then
  echo $LD $SOFLAGS $LDFLAGS -o $LIB $OBJS
  $LD $SOFLAGS $LDFLAGS -o $LIB $OBJS
elif [ $PLATFORM = fbsd ]; then
   echo $PLATFORM: $LD $SOFLAGS $LDFLAGS -o $LIB $OBJS
   $LD $SOFLAGS $LDFLAGS -o $LIB `lorder $OBJS | tsort -q`
# for elf:  echo $PLATFORM: $LD $SOFLAGS$SONAME $LDFLAGS -o $LIB $OBJS
# for elf:  $LD $SOFLAGS$SONAME $LDFLAGS -o $LIB `lorder $OBJS | tsort -q`
elif [ $LD = KCC ]; then
   echo $LD $LDFLAGS -o $LIB $OBJS $EXTRA
   $LD $LDFLAGS -o $LIB $OBJS $EXTRA
else
   echo $LD $SOFLAGS$SONAME $LDFLAGS -o $LIB $OBJS $EXTRA
   $LD $SOFLAGS$SONAME $LDFLAGS -o $LIB $OBJS $EXTRA
fi

chmod 555 $LIB

echo "$LIB done"

exit 0
