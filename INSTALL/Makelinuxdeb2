# Makefile of ROOT for Linux (Debian) with glibc and egcs
# Changes for Debian 2.0:
# libncurses does not exist, remove -lncurses
# problems when using gcc c-compiler, change to egcc

include ../Makefile.config

PLATFORM      = linux


OPT           = -g -O2
NOOPT         =

# Compiler:
CXX           = g++
CC            = egcc
CXXFLAGS      = -Wall -fPIC -DR__GLIBC $(EXTRA_CXXFLAGS)
CFLAGS        = -Wall -fPIC -DR__GLIBC $(EXTRA_CFLAGS)
CINTCXXFLAGS  = -Wall -fPIC $(EXTRA_CXXFLAGS) \
                -DG__REGEXP -DG__UNIX -DG__SHAREDLIB \
                -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO
CINTCFLAGS    = -Wall -fPIC $(EXTRA_CFLAGS) \
                -DG__REGEXP -DG__UNIX -DG__SHAREDLIB \
                -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO

# Linker:
LD            = g++
LDFLAGS       = $(OPT) $(EXTRA_LDFLAGS)
SOFLAGS       = -shared -Wl,-soname,
SOEXT         = so
SYSLIBS       = -lnsl -lm -ldl -rdynamic
XLIBS         = -L/usr/X11R6/lib -lX11 -lXpm
CILIBS        = -lm -ldl -rdynamic
CRYPTLIBS     = -lcrypt
F77           = g77
F77FLAGS      = $(OPT)
F77LIBS       = -lg2c


##### MACROS and TARGETS #####

include Make-macros


##### DEPENDENCIES #####

include Make-depend
