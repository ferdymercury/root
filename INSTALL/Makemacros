depend:
		$(MAKEDEP) -fMake-depend -Y -- $(CXXFLAGS) -- $(ALLSRCS) > /dev/null 2>&1
		@cat Make-depend | sed -e "s:$(ROOTSYS):..:" > Make-depend.relative
		@mv -f Make-depend.relative Make-depend

dist:
		rm -f root.tar.gz ; \
		tar cvf root_src.tar README Make* *.c *.cxx *.h; \
		gzip root_src.tar

clean:
		@rm -f $(ALLOBJS) $(CINTTMPO) $(ROOTCINTTMPO) \
			__compiledata __makeinfo *~

distclean:      clean
		@rm -f $(ALLDICT) $(ALLLIBS) $(CINTLIB) \
			$(ALLEXECS) $(CINT) $(ROOTCINT) $(ROOTCINTTMP)

install:
		@(if [ $(ROOTSYS)/bin = $(BINDIR) ] ; then \
			echo "Everything already installed..."; \
		else \
			echo "Installing binaries in $(BINDIR)"; \
			$(INSTALL) $(ALLEXECS) $(CINT) $(ROOTCINT) $(BINDIR); \
			echo "Installing libraries in $(LIBDIR)"; \
			chmod u+w $(LIBDIR)/*; \
			$(INSTALL) $(ALLLIBS) $(LIBDIR); \
			$(INSTALL) $(CINTLIB) $(LIBDIR); \
			echo "Installing headers in $(INCDIR)"; \
			$(INSTALLDATA) *.h $(INCDIR); \
			echo "Installing MAIN_rmain.cxx in $(INCDIR)"; \
			$(INSTALLDATA) MAIN_rmain.cxx $(INCDIR); \
			echo "Installing $(MAKEINFO) in $(CINTINCDIR)"; \
			$(INSTALLDATA) $(MAKEINFO)  $(CINTINCDIR); \
			echo "Installing sources in $(SRCDIR)"; \
			$(INSTALLDATA) *.c *.cxx $(SRCDIR); \
		fi)
