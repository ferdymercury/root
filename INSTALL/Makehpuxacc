# Makefile of ROOT for HP-UX with aCC

PLATFORM      = hpux

CXX           = aCC
CC            = cc
CXXFLAGS      = +W70,495,740,749,829 -DR__ACC -z +Z
CFLAGS        = -Ae -z +Z
CINTCXXFLAGS  = -z +Z -DG__REGEXP -DG__UNIX -DG__HPUXCPPDLL \
                -DG__SHAREDLIB -D_POSIX2_SOURCE -DG__ROOT -DG__REDIRECTIO
CINTCFLAGS    = -Ae -z +Z -DG__REGEXP -DG__UNIX -DG__HPUXCPPDLL \
                -DG__SHAREDLIB -D_POSIX2_SOURCE -DG__ROOT -DG__REDIRECTIO \
                -D__STDCPP__
OPT           = -g
NOOPT         =
LD            = aCC
LDFLAGS       = $(OPT) -z -Wl,+s -Wl,-E
SOFLAGS       = -b -Wl,+vnocompatwarnings
SOEXT         = sl
SYSLIBS       = -lm -ldld
SYSXLIBS      = -lX11 -lm -ldld
XLIBS         = $(ROOTSYS)/lib/libXpm.a -lX11
CILIBS        = -lm -Wl,-E -ldld -lcurses


##### MACROS and TARGETS #####

include Make-macros


##### DEPENDENCIES #####

include Make-depend

