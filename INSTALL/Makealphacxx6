# Makefile to build ROOT for DEC unix with cxx 6

include ../Makefile.config

PLATFORM      = alpha

# OPT         = -g
OPT           = -O2
NOOPT         =

# Compiler:
CXX           = cxx
CC            = cc
CXXFLAGS      = -nostdnew -nortti -D__osf__ -D__alpha $(EXTRA_CXXFLAGS)
CFLAGS        = $(EXTRA_CFLAGS)
CINTCXXFLAGS  = -nostdnew -DG__DECCXX $(EXTRA_CXXFLAGS) \
                -DG__REGEXP -DG__UNIX -DG__SHAREDLIB \
                -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO
CINTCFLAGS    = -DG__DECCXX -DG__REGEXP -DG__UNIX -DG__SHAREDLIB \
                -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO $(EXTRA_CFLAGS)

# Linker:
LD            = cxx
F77LD         = f77
LDFLAGS       = $(OPT) $(EXTRA_LDFLAGS)
SOFLAGS       = -shared -Wl,-expect_unresolved,*,-soname,
SOEXT         = so

# System libraries:
SYSLIBS       = -lm
XLIBS         = -L$(LPATH) -lXpm -lX11
CILIBS        = -lm -ltermcap
F77LIBS       = /usr/shlib/libFutil.so /usr/shlib/libfor.so /usr/shlib/libots.so


##### MACROS and TARGETS #####

include Make-macros


##### DEPENDENCIES #####

include Make-depend
