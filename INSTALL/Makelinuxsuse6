# Makefile of ROOT for Linux with glibc and egcs (SuSE v6.0)

include ../Makefile.config

PLATFORM      = linux

CXX           = g++
CC            = gcc
CXXFLAGS      = -Wall -fPIC -DR__GLIBC $(EXTRA_CXXFLAGS)
CFLAGS        = -Wall -fPIC -DR__GLIBC $(EXTRA_CFLAGS)
CINTCXXFLAGS  = -Wall -fPIC -DG__REGEXP $(EXTRA_CXXFLAGS) \
                -DG__UNIX -DG__SHAREDLIB -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO
CINTCFLAGS    = -Wall -fPIC -DG__REGEXP -DG__UNIX -DG__SHAREDLIB \
                -DG__OSFDLL -DG__ROOT -DG__REDIRECTIO $(EXTRA_CFLAGS)
OPT           = -O
NOOPT         =
LD            = g++
LDFLAGS       = $(OPT) $(EXTRA_LDFLAGS)
SOFLAGS       = -shared -Wl,-soname,
SOEXT         = so
SYSLIBS       = -lm -ldl -rdynamic
XLIBS         = ../lib/libXpm.a -L/usr/X11R6/lib -lX11
CILIBS        = -lm -lncurses -ldl -rdynamic
CRYPTLIBS     = -lcrypt
F77           = g77
F77FLAGS      = $(OPT)
F77LIBS       = -lg2c

VPATH         = ../include


##### MACROS and TARGETS #####

include Make-macros


##### DEPENDENCIES #####

include Make-depend

